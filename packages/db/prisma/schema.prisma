// Schéma de données LinkAffi Pro — phases 0 et 1.
// Noms en anglais, commentaires en français. Documentation : docs/DATA-MODEL.md.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

/// Rôle d'un utilisateur interne.
enum Role {
  ADMIN
  MANAGER
}

/// Univers d'affiliation.
enum Vertical {
  CASINO
  SPORTS
  DATING
}

/// Type de conversation Telegram.
enum ChatType {
  CHANNEL
  GROUP
}

/// Statut d'une demande d'adhésion.
enum MembershipStatus {
  REQUESTED
  PENDING_GATE
  SCHEDULED
  APPROVED
  DECLINED
  LEFT
  KICKED
  EXPIRED
  FAILED
}

/// Mode d'approbation d'une règle.
enum ApprovalMode {
  IMMEDIATE
  DELAY
  MANUAL
}

/// Exigence des canaux à rejoindre d'abord.
enum GateMode {
  NONE
  REQUIRED
  SOFT
}

/// Action à l'expiration d'une demande.
enum ExpireAction {
  DECLINE
  APPROVE
  KEEP
}

/// Nature d'un lien d'invitation.
enum InviteLinkKind {
  AD_ENTRY
  GATE
  MANUAL
  /// Lien de partage créé depuis la fiche du canal (phase 11), nommé, avec demande d'adhésion, à poster où l'on veut
  /// (`sourceChannelId` facultatif : « à poster dans <canal> »).
  SHARE
  /// Lien d'une campagne Telegram d'affilié créée DANS Link Affi (phase 13, docs/LINKAFFI-PARTENAIRES.md) : demandé
  /// par Link Affi via l'API d'intégration (`POST /invite-links`), avec demande d'adhésion ; `linkaffi.me/go/<clé>`
  /// redirige vers lui. Les personnes entrées par ce lien sont rattachées à l'affilié (premier affilié gagne).
  LINKAFFI
}

/// Qui publie un message de canal (phase 12). Telegram interdit les emojis animés (emojis personnalisés des packs
/// Premium) aux bots dans les canaux : un message de canal qui en contient est publié par le compte Telegram connecté
/// (MTProto, Réglages → Connecteurs → Telegram), sans boutons.
enum PostPublisher {
  /// Le bot du message (Bot API), comme avant la phase 12.
  BOT
  /// Le compte Telegram Premium connecté (TelegramUserSession), pour un message avec emojis animés.
  ACCOUNT
}

/// D'où vient un emoji animé de la bibliothèque (phase 12).
enum CustomEmojiSource {
  /// Message transféré (ou envoyé) au bot par un membre de l'équipe.
  FORWARD
  /// Lien d'un pack collé dans le site (t.me/addemoji/<nom>).
  PACK
  /// Packs installés sur le compte Telegram connecté.
  ACCOUNT
}

/// Portée d'une règle d'adhésion (phase 11) : règle par défaut du canal, ou exception selon la provenance.
/// Résolution, du plus précis au plus général : INVITE_LINK → SOURCE_CHANNEL → SOURCE_KIND → DEFAULT
/// (fonction pure `pickRuleForProvenance` de packages/core/src/provenance.ts).
enum ApprovalRuleScope {
  /// Règle par défaut du canal (`isDefault = true`).
  DEFAULT
  /// Exception d'un lien d'invitation précis (`inviteLinkId`).
  INVITE_LINK
  /// Exception pour les personnes venues d'un de nos canaux (`sourceChannelId` du lien GATE ou SHARE).
  SOURCE_CHANNEL
  /// Exception pour un type de provenance (`sourceKind`).
  SOURCE_KIND
}

/// Type de provenance d'une exception `SOURCE_KIND` (phase 11).
enum ApprovalSourceKind {
  /// Venue du bouton « canal à rejoindre » (obligatoire) d'un de nos canaux (lien GATE).
  GATE
  /// Venue de n'importe lequel de nos canaux (lien GATE, ou lien SHARE posté dans un de nos canaux).
  ANY_CHANNEL
  /// Venue de n'importe quelle pub (lien d'entrée AD_ENTRY).
  AD_ANY
  /// Venue d'une pub TikTok (lien d'entrée AD_ENTRY, plateforme TIKTOK).
  AD_TIKTOK
  /// Venue d'une pub Meta (lien d'entrée AD_ENTRY, plateforme META).
  AD_META
  /// Venue de n'importe quel lien de partage (SHARE).
  SHARE
  /// Venue de n'importe quelle campagne Telegram d'affilié Link Affi (lien LINKAFFI, phase 13).
  LINKAFFI_ANY
  /// Venue d'une campagne d'un affilié Link Affi précis (`ApprovalRule.linkaffiAffiliateId`, phase 13).
  LINKAFFI_AFFILIATE
}

/// Plateforme publicitaire.
enum AdPlatform {
  TIKTOK
  META
  OTHER
}

/// État d'une connexion à un compte publicitaire (phase 7).
enum ConnectionStatus {
  ACTIVE
  NEEDS_RECONNECT
  DISABLED
}

/// Nature d'un lien traqué goolink.
enum TrackingLinkKind {
  AD_ENTRY
  OFFER
  BUTTON
  GENERIC
}

/// Statut d'un message programmé.
enum PostStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  DELETED
  CANCELLED
}

/// Déclencheur d'une séquence de messages privés.
enum SequenceTrigger {
  JOIN_REQUEST
  GATE_REMINDER
  GATE_SATISFIED
  APPROVED
  START
  OFFER_REPLY
}

/// Nature d'un message privé sortant.
enum OutboundKind {
  WELCOME
  GATE_REMINDER
  ACCEPTED
  OFFER_REPLY
  BROADCAST
  AUTOMATION
  TEST
}

/// Statut d'un message privé sortant.
enum OutboundStatus {
  QUEUED
  SENT
  FAILED
  BLOCKED
}

/// Origine des données d'un programme d'affiliation.
enum AffiliateSource {
  LINKAFFI
  CSV
  API
}

/// Type d'événement joueur.
/// Phase 10 : CPA = commission CPA créditée (part affilié, montant POSITIF, datée `players.cpa_credited_at`) ;
/// CPA_REVERSAL = annulation de cette commission (montant NÉGATIF, datée `players.cpa_reversed_at`). La somme des deux
/// sur une période donne la CPA nette : une CPA annulée se retranche le jour de l'annulation.
enum PlayerEventType {
  CLICK
  REGISTRATION
  FTD
  DEPOSIT
  REDEPOSIT
  NGR
  OTHER
  CPA
  CPA_REVERSAL
}

/// Statut d'une pub / campagne publicitaire.
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

/// Origine d'une ligne de coût publicitaire.
enum CostSource {
  CSV
  MANUAL
  API
}

/// Nature d'un import de fichier.
enum ImportKind {
  TIKTOK_CSV
  META_CSV
  COSTS_MANUAL
  PLAYERS_CSV
}

/// Statut d'un postback reçu.
enum PostbackStatus {
  ACCEPTED
  IGNORED
  ERROR
}

/// Statut d'un envoi groupé.
enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

/// Déclencheur d'une automatisation.
enum AutomationTrigger {
  JOINED
  OFFER_CLICKED
  REGISTERED
  DEPOSITED
  INACTIVE
  LEFT
  SPEND_LEVEL_REACHED
}

/// Statut d'une exécution d'automatisation.
enum AutomationRunStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
  CANCELLED
}

/// Gravité d'une alerte.
enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// ============================================================
// Phase 0 : utilisateurs, bots, canaux, membres, événements
// ============================================================

/// Utilisateur interne (admin ou manager). Pas d'inscription publique.
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  role              Role      @default(MANAGER)
  isActive          Boolean   @default(true)
  /// Identifiant Telegram lié via « Mon compte » (optionnel).
  telegramUserId    BigInt?   @unique
  /// Jeton temporaire pour lier le compte Telegram (t.me/<bot>?start=admin_<token>).
  telegramLinkToken String?   @unique
  /// Version de session : incrémentée au changement de mot de passe, de rôle ou à la désactivation.
  /// Le JWT porte la version émise (`sv`) ; si elle diffère, la session est refusée (déconnexion de tous les appareils).
  sessionVersion    Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  invitationsSent      Invitation[]          @relation("InvitedBy")
  auditLogs            AuditLog[]
  inviteLinks          InviteLink[]
  trackingLinks        TrackingLink[]
  mediaAssets          MediaAsset[]
  postsCreated         Post[]                @relation("PostCreatedBy")
  postsUpdated         Post[]                @relation("PostUpdatedBy")
  memberNotes          MemberNote[]
  importBatches        ImportBatch[]
  broadcasts           Broadcast[]
  adAccountConnections AdAccountConnection[]
  aiSuggestions        AiSuggestion[]
  customEmojis         CustomEmoji[]
}

/// Invitation à rejoindre l'équipe, créée par un ADMIN.
model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(MANAGER)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([email])
}

/// Journal des actions des utilisateurs (append-only).
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
}

/// Bot Telegram piloté par la plateforme. Le jeton est chiffré (AES-256-GCM).
model Bot {
  id             String    @id @default(cuid())
  name           String
  username       String    @unique
  telegramBotId  BigInt    @unique
  tokenEncrypted String
  vertical       Vertical
  isActive       Boolean   @default(true)
  /// Secret attendu dans l'en-tête X-Telegram-Bot-Api-Secret-Token.
  webhookSecret  String
  lastWebhookAt  DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  channelAdmins      ChannelBotAdmin[]
  memberStates       MemberBotState[]
  primaryChannels    Channel[]                @relation("PrimaryBot")
  events             Event[]
  inviteLinks        InviteLink[]
  memberships        Membership[]             @relation("ApprovedByBot")
  clicks             Click[]
  posts              Post[]
  sequences          Sequence[]
  outboundMessages   OutboundMessage[]
  mediaTelegramFiles MediaAssetTelegramFile[]
  broadcasts         Broadcast[]
}

/// Canal (ou groupe) Telegram détecté automatiquement.
model Channel {
  id             String    @id @default(cuid())
  telegramChatId BigInt    @unique
  title          String
  username       String?
  type           ChatType  @default(CHANNEL)
  vertical       Vertical?
  language       String    @default("fr")
  primaryBotId   String?
  primaryBot     Bot?      @relation("PrimaryBot", fields: [primaryBotId], references: [id])
  isActive       Boolean   @default(true)
  isTest         Boolean   @default(false)
  isMediaLibrary Boolean   @default(false)
  settings       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  botAdmins     ChannelBotAdmin[]
  events        Event[]
  memberships   Membership[]
  approvalRules ApprovalRule[]
  inviteLinks   InviteLink[]
  trackingLinks TrackingLink[]
  posts         Post[]
  sequences     Sequence[]
  dailyStats    DailyStat[]
}

/// Droits d'administrateur d'un bot sur un canal.
model ChannelBotAdmin {
  id         String    @id @default(cuid())
  channelId  String
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  botId      String
  bot        Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  rights     Json      @default("{}")
  detectedAt DateTime  @default(now())
  revokedAt  DateTime?

  @@unique([channelId, botId])
}

/// Membre Telegram vu par au moins un bot.
model Member {
  id                         String      @id @default(cuid())
  telegramUserId             BigInt      @unique
  firstName                  String?
  lastName                   String?
  username                   String?
  languageCode               String?
  isPremium                  Boolean     @default(false)
  firstSeenAt                DateTime    @default(now())
  lastSeenAt                 DateTime    @default(now())
  /// Anonymisé (suppression sur demande) : identité effacée, événements conservés sans données personnelles.
  anonymizedAt               DateTime?
  /// Étiquettes libres (JSON : string[]).
  tags                       Json        @default("[]")
  /// Affilié Link Affi qui a amené ce membre (phase 13) : premier affilié gagne, jamais écrasé automatiquement ;
  /// changé ou retiré seulement par un ADMIN (journal). `affiliateAttributionEndsAt` : fin de l'attribution si la
  /// campagne a une durée (null = à vie).
  linkaffiCampaignKey        String?
  linkaffiAffiliateId        String?
  affiliateAttributedAt      DateTime?
  affiliateAttributionEndsAt DateTime?
  affiliateInviteLinkId      String?
  affiliateInviteLink        InviteLink? @relation("AffiliateInviteLink", fields: [affiliateInviteLinkId], references: [id], onDelete: SetNull)

  botStates        MemberBotState[]
  events           Event[]
  memberships      Membership[]
  clicks           Click[]
  players          Player[]
  outboundMessages OutboundMessage[]
  notes            MemberNote[]
  automationRuns   AutomationRun[]

  @@index([linkaffiAffiliateId])
  @@index([linkaffiCampaignKey])
  @@index([lastSeenAt])
  @@index([firstSeenAt])
  @@index([anonymizedAt, lastSeenAt])
}

/// État de la relation entre un membre et un bot (peut-on lui écrire en privé ?).
model MemberBotState {
  id        String    @id @default(cuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  canDm     Boolean   @default(false)
  startedAt DateTime?
  blockedAt DateTime?
  lastDmAt  DateTime?

  @@unique([memberId, botId])
  @@index([botId, canDm])
}

/// Journal d'événements (append-only : jamais de mise à jour ni de suppression dans le code).
model Event {
  id         String   @id @default(cuid())
  type       String
  occurredAt DateTime @default(now())
  memberId   String?
  member     Member?  @relation(fields: [memberId], references: [id])
  channelId  String?
  channel    Channel? @relation(fields: [channelId], references: [id])
  botId      String?
  bot        Bot?     @relation(fields: [botId], references: [id])
  payload    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([type, occurredAt])
  @@index([memberId, occurredAt])
  @@index([channelId, occurredAt])
  @@index([botId, occurredAt])
  @@index([occurredAt])
}

/// Réglage global (clé → valeur JSON).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ============================================================
// Phase 1 : adhésions
// ============================================================

/// Demande d'adhésion d'un membre à un canal. Un enregistrement par demande (un membre qui revient en crée un nouveau).
/// Code court pour les liens profonds `/start g<code>`.
model Membership {
  id              String           @id @default(cuid())
  code            String           @unique
  memberId        String
  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  channelId       String
  channel         Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  status          MembershipStatus @default(REQUESTED)
  inviteLinkId    String?
  inviteLink      InviteLink?      @relation(fields: [inviteLinkId], references: [id])
  approvalRuleId  String?
  approvalRule    ApprovalRule?    @relation(fields: [approvalRuleId], references: [id])
  /// Identifiant du chat privé fourni par Telegram dans chat_join_request (user_chat_id).
  userChatId      BigInt?
  requestedAt     DateTime         @default(now())
  gateSatisfiedAt DateTime?
  approveAt       DateTime?
  approvedAt      DateTime?
  declinedAt      DateTime?
  joinedAt        DateTime?
  leftAt          DateTime?
  expiresAt       DateTime?
  approvedByBotId String?
  approvedByBot   Bot?             @relation("ApprovedByBot", fields: [approvedByBotId], references: [id])
  /// Instantané de la source : lien, pub, campagne (JSON). Phase 11 : `provenance` = provenance résolue
  /// `{ type, sourceChannelId, inviteLinkId, adPlatform, label }` et `appliedRule` = règle appliquée
  /// `{ id, scope, label, noGates? }` (voir docs/DATA-MODEL.md).
  source          Json             @default("{}")
  remindersSent   Int              @default(0)
  lastReminderAt  DateTime?
  attempts        Int              @default(0)
  lastError       String?
  updatedAt       DateTime         @updatedAt

  @@unique([memberId, channelId, requestedAt])
  @@index([channelId, status])
  @@index([status, approveAt])
  @@index([status, expiresAt])
  @@index([memberId, channelId])
  @@index([channelId, requestedAt])
  @@index([inviteLinkId, requestedAt])
  @@index([requestedAt])
  @@index([approvedAt])
  @@index([joinedAt])
  @@index([leftAt])
}

/// Règle d'approbation d'un canal : règle par défaut (`scope = DEFAULT`, `isDefault = true`) ou exception selon la
/// provenance (phase 11 : `scope` INVITE_LINK / SOURCE_CHANNEL / SOURCE_KIND, `isDefault = false`).
model ApprovalRule {
  id                   String              @id @default(cuid())
  channelId            String
  channel              Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name                 String
  isDefault            Boolean             @default(false)
  /// Portée de la règle (phase 11). Les règles d'avant la phase 11 : DEFAULT, ou INVITE_LINK si `inviteLinkId`.
  scope                ApprovalRuleScope   @default(DEFAULT)
  /// Règle spécifique à un lien d'invitation (`scope = INVITE_LINK`, sinon règle du canal).
  inviteLinkId         String?             @unique
  inviteLink           InviteLink?         @relation("RuleForLink", fields: [inviteLinkId], references: [id])
  /// Canal d'où vient la personne (`scope = SOURCE_CHANNEL`) : `sourceChannelId` du lien GATE ou SHARE. Pas de clé
  /// étrangère (comme `InviteLink.sourceChannelId`) : un canal supprimé laisse une exception affichée « canal supprimé ».
  sourceChannelId      String?
  /// Type de provenance (`scope = SOURCE_KIND`).
  sourceKind           ApprovalSourceKind?
  /// Affilié Link Affi visé par une exception `SOURCE_KIND` = LINKAFFI_AFFILIATE (phase 13 ; identifiant Link Affi).
  linkaffiAffiliateId  String?
  /// Texte lisible de l'exception (« Venu de Tir Cadré »), recalculé à l'enregistrement.
  label                String?
  /// Ordre des exceptions de même niveau (ordre choisi par l'équipe, du plus petit au plus grand).
  sortOrder            Int                 @default(0)
  /// Message privé envoyé à l'arrivée de la demande (accueil, ou court message pour une personne venue d'un canal
  /// obligatoire). Toujours envoyé quand des canaux sont à rejoindre (sinon la personne resterait bloquée).
  sendWelcome          Boolean             @default(true)
  mode                 ApprovalMode        @default(DELAY)
  delaySeconds         Int                 @default(0)
  /// Liste d'identifiants de canaux à rejoindre d'abord (JSON : string[]).
  gateChannelIds       Json                @default("[]")
  gateMode             GateMode            @default(NONE)
  /// Minutes après la demande pour chaque rappel (JSON : number[]), ex. [60, 1440].
  reminderAfterMinutes Json                @default("[60, 1440]")
  maxReminders         Int                 @default(2)
  expireAfterHours     Int?
  expireAction         ExpireAction        @default(KEEP)
  sendAcceptedMessage  Boolean             @default(true)
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  memberships Membership[]

  @@index([channelId, isDefault])
  @@index([channelId, scope, isActive])
}

/// Lien d'invitation Telegram créé par la plateforme (entrée par pub, gate, manuel).
model InviteLink {
  id                    String         @id @default(cuid())
  channelId             String
  channel               Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  botId                 String
  bot                   Bot            @relation(fields: [botId], references: [id])
  telegramInviteLink    String         @unique
  name                  String
  kind                  InviteLinkKind @default(AD_ENTRY)
  createsJoinRequest    Boolean        @default(true)
  campaignId            String?
  campaign              Campaign?      @relation(fields: [campaignId], references: [id])
  adPlatform            AdPlatform?
  adCampaignName        String?
  adSetName             String?
  adName                String?
  adExternalIds         Json?
  /// Canal source pour un lien GATE (d'où vient le membre), ou canal où poster un lien SHARE (facultatif).
  sourceChannelId       String?
  /// Campagne Telegram d'affilié créée dans Link Affi (kind LINKAFFI, phase 13) : clé du lien de l'affilié
  /// (`linkaffi.me/go/<clé>`), nom de la campagne, affilié, durée d'attribution en jours (null = à vie).
  /// Idempotence de `POST /invite-links` : même clé + même canal = même lien.
  linkaffiCampaignKey   String?
  linkaffiCampaignName  String?
  linkaffiAffiliateId   String?
  linkaffiAffiliateName String?
  attributionDays       Int?
  language              String         @default("fr")
  isActive              Boolean        @default(true)
  createdById           String?
  createdBy             User?          @relation(fields: [createdById], references: [id])
  /// Compteurs dénormalisés.
  requests              Int            @default(0)
  approved              Int            @default(0)
  joined                Int            @default(0)
  left                  Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  memberships      Membership[]
  affiliateMembers Member[]       @relation("AffiliateInviteLink")
  trackingLinks    TrackingLink[]
  rule             ApprovalRule?  @relation("RuleForLink")
  ad               Ad?

  @@unique([linkaffiCampaignKey, channelId])
  @@index([linkaffiAffiliateId])
  @@index([channelId, kind])
  @@index([kind, createdAt])
  @@index([campaignId])
}

// ============================================================
// Phase 1 : liens traqués et clics
// ============================================================

/// Lien court goolink (slug base62 de 6 à 10 caractères).
model TrackingLink {
  id                  String             @id @default(cuid())
  slug                String             @unique
  kind                TrackingLinkKind   @default(GENERIC)
  /// URL de destination avec placeholders {subid}, {click_id}, {member_id}, {post_id}.
  destinationTemplate String
  label               String
  inviteLinkId        String?
  inviteLink          InviteLink?        @relation(fields: [inviteLinkId], references: [id])
  channelId           String?
  channel             Channel?           @relation(fields: [channelId], references: [id])
  campaignId          String?
  campaign            Campaign?          @relation(fields: [campaignId], references: [id])
  affiliateCampaignId String?
  affiliateCampaign   AffiliateCampaign? @relation(fields: [affiliateCampaignId], references: [id])
  postId              String?
  post                Post?              @relation(fields: [postId], references: [id])
  /// Relance automatique qui a envoyé ce bouton (Offre ou lien traqué d'un message de relance), comme `postId` pour un
  /// message de canal (phase 10). Relance supprimée : le lien reste utilisable, le rattachement est effacé.
  automationRuleId    String?
  automationRule      AutomationRule?    @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)
  isActive            Boolean            @default(true)
  createdById         String?
  createdBy           User?              @relation(fields: [createdById], references: [id])
  /// Compteurs dénormalisés (humains seulement).
  clicks              Int                @default(0)
  uniqueClicks        Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  clickRecords Click[]
  ad           Ad?

  @@index([kind, isActive])
  @@index([postId])
  @@index([kind, createdAt])
  @@index([inviteLinkId])
  @@index([channelId])
  @@index([affiliateCampaignId])
  @@index([automationRuleId])
}

/// Clic sur un lien traqué ou un bouton. `subId` unique pour les clics OFFER (12 caractères base62, sans point).
model Click {
  id                          String       @id @default(cuid())
  trackingLinkId              String
  trackingLink                TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  subId                       String?      @unique
  memberId                    String?
  member                      Member?      @relation(fields: [memberId], references: [id])
  postId                      String?
  post                        Post?        @relation(fields: [postId], references: [id])
  botId                       String?
  bot                         Bot?         @relation(fields: [botId], references: [id])
  ipHash                      String?
  userAgent                   String?
  isBot                       Boolean      @default(false)
  referer                     String?
  country                     String?
  ttclid                      String?
  fbclid                      String?
  gclid                       String?
  utm                         Json?
  /// URL finale envoyée au membre (offres), pour diagnostic.
  destination                 String?
  /// Campagne Telegram d'affilié Link Affi du membre au moment du clic d'offre (paramètre `tg`, phase 13).
  linkaffiTelegramCampaignKey String?
  createdAt                   DateTime     @default(now())

  players Player[]

  @@index([linkaffiTelegramCampaignKey])
  @@index([memberId, createdAt])
  @@index([trackingLinkId, createdAt])
  @@index([postId, createdAt])
  @@index([ipHash, userAgent, trackingLinkId, createdAt])
  @@index([isBot, createdAt])
}

// ============================================================
// Phase 1 : messages programmés
// ============================================================

/// Catégorie de message (Bonus, Preuve de gains, Teasing…).
model MessageCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  color     String    @default("#64748b")
  vertical  Vertical?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  posts Post[]
}

/// Média réutilisable (photo, vidéo, gif, document) stocké en base (≤ 50 Mo).
model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  mimeType    String
  size        Int
  sha256      String   @unique
  bytes       Bytes
  width       Int?
  height      Int?
  duration    Int?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  telegramFiles    MediaAssetTelegramFile[]
  sequenceSteps    SequenceStep[]
  broadcasts       Broadcast[]
  outboundMessages OutboundMessage[]
}

/// Identifiant Telegram d'un média une fois envoyé par un bot (réutilisable sans ré-upload).
model MediaAssetTelegramFile {
  id             String     @id @default(cuid())
  assetId        String
  asset          MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  botId          String
  bot            Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  telegramFileId String
  fileUniqueId   String
  createdAt      DateTime   @default(now())

  @@unique([assetId, botId])
}

/// Emoji animé (emoji personnalisé d'un pack Premium Telegram) de la bibliothèque de l'équipe (phase 12). Inséré dans
/// un texte HTML Telegram sous la forme `<tg-emoji emoji-id="<customEmojiId>"><fallback></tg-emoji>`.
model CustomEmoji {
  id            String            @id @default(cuid())
  /// Identifiant Telegram de l'emoji (`custom_emoji_id`, entier 64 bits en chaîne).
  customEmojiId String            @unique
  /// Emoji standard affiché quand l'animation n'est pas disponible (et compté dans la longueur du texte).
  fallback      String
  /// Pack (nom court Telegram, t.me/addemoji/<setName>) et son titre, s'ils sont connus.
  setName       String?
  setTitle      String?
  /// Format du fichier Telegram : "tgs" (Lottie compressé), "webm" (vidéo) ou "webp" (image) ; null tant qu'inconnu.
  format        String?
  /// Aperçu (fichier Telegram téléchargé, quelques Ko) et son type MIME ; null tant que le worker ne l'a pas récupéré.
  previewBytes  Bytes?
  previewMime   String?
  /// Dernière tentative de récupération de l'aperçu et son erreur éventuelle.
  previewAt     DateTime?
  previewError  String?
  source        CustomEmojiSource
  addedById     String?
  addedBy       User?             @relation(fields: [addedById], references: [id], onDelete: SetNull)
  /// Utilisation par l'équipe (emojis récents du sélecteur).
  useCount      Int               @default(0)
  lastUsedAt    DateTime?
  /// Retiré de la bibliothèque (les messages qui l'utilisent gardent leur balise).
  hiddenAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([setName])
  @@index([lastUsedAt])
  @@index([hiddenAt])
}

/// Message programmé pour un canal. `code` court pour les liens profonds d'offre.
model Post {
  id                  String           @id @default(cuid())
  code                String           @unique
  channelId           String
  channel             Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  botId               String
  bot                 Bot              @relation(fields: [botId], references: [id])
  status              PostStatus       @default(DRAFT)
  scheduledAt         DateTime?
  sentAt              DateTime?
  /// Identifiants Telegram des messages envoyés (JSON : number[] ; plusieurs pour un album).
  telegramMessageIds  Json             @default("[]")
  categoryId          String?
  category            MessageCategory? @relation(fields: [categoryId], references: [id])
  language            String           @default("fr")
  /// Texte en HTML Telegram (b, i, u, s, a, code, pre, tg-spoiler, blockquote).
  text                String           @default("")
  /// Médias dans l'ordre (JSON : string[] d'identifiants MediaAsset).
  mediaAssetIds       Json             @default("[]")
  /// Lignes de boutons (JSON, voir docs/DATA-MODEL.md).
  buttons             Json             @default("[]")
  pinAfterSend        Boolean          @default(false)
  unpinPrevious       Boolean          @default(false)
  deleteAfterMinutes  Int?
  disableNotification Boolean          @default(false)
  protectContent      Boolean          @default(false)
  disableLinkPreview  Boolean          @default(true)
  isTemplate          Boolean          @default(false)
  templateName        String?
  /// Univers du modèle (classement de la bibliothèque de modèles ; renseigné aussi sur les messages créés depuis un canal typé).
  vertical            Vertical?
  /// Test A/B : identifiant commun aux deux variantes d'un même test et lettre de la variante (A ou B).
  abGroupId           String?
  abVariant           String?
  lastError           String?
  attempts            Int              @default(0)
  createdById         String?
  createdBy           User?            @relation("PostCreatedBy", fields: [createdById], references: [id])
  updatedById         String?
  updatedBy           User?            @relation("PostUpdatedBy", fields: [updatedById], references: [id])
  duplicatedFromId    String?
  duplicatedFrom      Post?            @relation("PostDuplicates", fields: [duplicatedFromId], references: [id])
  duplicates          Post[]           @relation("PostDuplicates")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  stats            PostStats?
  trackingLinks    TrackingLink[]
  clicks           Click[]
  outboundMessages OutboundMessage[]
  viewSamples      PostViewSample[]
  /// Prochain relevé des vues par le compte Telegram connecté (phase 7) ; null = plus de relevé.
  viewsNextAt      DateTime?
  /// Qui publie ce message (phase 12) : BOT (défaut) ou ACCOUNT (compte Telegram connecté, message avec emojis animés,
  /// sans boutons). Un message publié par le compte n'est JAMAIS modifié ensuite par le bot (les emojis animés
  /// disparaîtraient) : épingler, désépingler et supprimer passent aussi par le compte.
  publisher        PostPublisher     @default(BOT)

  @@index([channelId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([isTemplate, scheduledAt])
  @@index([categoryId])
  @@index([abGroupId])
  @@index([isTemplate, vertical])
}

/// Statistiques dénormalisées d'un message.
model PostStats {
  postId         String   @id
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  views          Int      @default(0)
  forwards       Int      @default(0)
  reactions      Json     @default("{}")
  reactionsTotal Int      @default(0)
  clicks         Int      @default(0)
  uniqueClickers Int      @default(0)
  offerClicks    Int      @default(0)
  registrations  Int      @default(0)
  ftds           Int      @default(0)
  deposits       Int      @default(0)
  depositAmount  Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt      DateTime @updatedAt
}

// ============================================================
// Phase 1 : séquences de messages privés
// ============================================================

/// Séquence de messages privés déclenchée par un événement, par canal et/ou par bot.
model Sequence {
  id        String          @id @default(cuid())
  name      String
  botId     String?
  bot       Bot?            @relation(fields: [botId], references: [id])
  channelId String?
  channel   Channel?        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  trigger   SequenceTrigger
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  steps SequenceStep[]

  /// Une seule séquence par canal et par déclencheur (phase 8 : plusieurs bots créaient les séquences par défaut en même temps).
  /// PostgreSQL traite les NULL comme distincts : les séquences globales (channelId vide) ne sont pas concernées,
  /// ce qui équivaut à un index unique partiel « WHERE channelId IS NOT NULL ».
  @@unique([channelId, trigger])
}

/// Étape d'une séquence : textes par langue, boutons, média, délai.
model SequenceStep {
  id           String      @id @default(cuid())
  sequenceId   String
  sequence     Sequence    @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order        Int         @default(0)
  delaySeconds Int         @default(0)
  /// Textes par langue (JSON : { fr: "...", en: "..." }), HTML Telegram, placeholders {prenom} {canal} {liste_canaux} {delai} {bot}.
  texts        Json        @default("{}")
  buttons      Json        @default("[]")
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])

  outboundMessages OutboundMessage[]

  @@index([sequenceId, order])
}

/// Message privé sortant (file d'attente et historique).
model OutboundMessage {
  id                String          @id @default(cuid())
  botId             String
  bot               Bot             @relation(fields: [botId], references: [id])
  memberId          String
  member            Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind              OutboundKind
  sequenceStepId    String?
  sequenceStep      SequenceStep?   @relation(fields: [sequenceStepId], references: [id])
  postId            String?
  post              Post?           @relation(fields: [postId], references: [id])
  broadcastId       String?
  broadcast         Broadcast?      @relation(fields: [broadcastId], references: [id])
  /// Relance automatique à l'origine du message (kind AUTOMATION), pour compter les « envoyés » par relance (phase 10).
  /// Relance supprimée : le message reste, le rattachement est effacé.
  automationRuleId  String?
  automationRule    AutomationRule? @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)
  /// Média joint (photo, vidéo, gif, document) envoyé avec le texte en légende.
  mediaAssetId      String?
  mediaAsset        MediaAsset?     @relation(fields: [mediaAssetId], references: [id])
  /// Identifiant du chat privé si différent du telegramUserId (user_chat_id).
  chatId            BigInt?
  text              String
  buttons           Json            @default("[]")
  status            OutboundStatus  @default(QUEUED)
  telegramMessageId Int?
  error             String?
  queuedAt          DateTime        @default(now())
  sentAt            DateTime?

  @@index([memberId, queuedAt])
  @@index([status, queuedAt])
  @@index([broadcastId, status])
  @@index([memberId, status, sentAt])
  @@index([automationRuleId, status])
}

// ============================================================
// Phase 1 : affiliation (Link Affi) et joueurs
// ============================================================

/// Programme d'affiliation (casino, bookmaker…), importé de Link Affi (`casinos`) ou saisi.
model AffiliateProgram {
  id         String          @id @default(cuid())
  name       String
  vertical   Vertical?
  source     AffiliateSource @default(LINKAFFI)
  externalId String?
  isActive   Boolean         @default(true)
  raw        Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  campaigns         AffiliateCampaign[]
  postbackEndpoints PostbackEndpoint[]
  dailyStats        AffiliateDailyStat[]

  @@unique([source, externalId])
}

/// Campagne / lien de suivi Link Affi (`campaigns`), avec le modèle d'URL portant le sub-ID.
model AffiliateCampaign {
  id                  String           @id @default(cuid())
  programId           String
  program             AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  externalId          String
  /// Clé de campagne Link Affi (8 caractères, ex. 47eb8mwc).
  campaignKey         String?
  name                String
  vertical            Vertical?
  /// URL avec placeholder du sub-ID, ex. https://linkaffi.me/go/47eb8mwc?sub_id={subid}
  trackingUrlTemplate String
  isActive            Boolean          @default(true)
  raw                 Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  players       Player[]
  trackingLinks TrackingLink[]
  dailyStats    AffiliateDailyStat[]

  @@unique([programId, externalId])
  @@index([campaignKey])
}

/// Joueur chez un programme, rattaché à un membre par sub-ID quand possible.
model Player {
  id                  String            @id @default(cuid())
  affiliateCampaignId String
  affiliateCampaign   AffiliateCampaign @relation(fields: [affiliateCampaignId], references: [id], onDelete: Cascade)
  externalPlayerId    String
  subId               String?
  /// Origine du sub-ID côté Link Affi : `postback` (sûr) ou `time_match` (secours), null sinon.
  subIdSource         String?
  clickId             String?
  click               Click?            @relation(fields: [clickId], references: [id])
  memberId            String?
  member              Member?           @relation(fields: [memberId], references: [id])
  registeredAt        DateTime?
  ftdAt               DateTime?
  ftdAmount           Decimal?          @db.Decimal(14, 2)
  depositCount        Int               @default(0)
  redepositCount      Int               @default(0)
  depositTotal        Decimal           @default(0) @db.Decimal(14, 2)
  ngr                 Decimal           @default(0) @db.Decimal(14, 2)
  currency            String            @default("EUR")
  status              String?
  /// Phase 10 : statut de la commission CPA chez Link Affi (`players.cpa_status` : none | approved | not_eligible |
  /// reversed), null tant que la synchro ne l'a pas lu.
  cpaStatus           String?
  /// Commission CPA côté affilié en EUR (`players.cpa_affiliate_amount`) ; null = aucune ou inconnue. Reste renseignée
  /// après une annulation (c'est le montant annulé).
  cpaAmount           Decimal?          @db.Decimal(14, 2)
  /// Crédit de la CPA (`players.cpa_credited_at`). Peut manquer pour d'anciens joueurs approuvés : repli sur
  /// `qualified_at` (dans `raw`).
  cpaCreditedAt       DateTime?
  /// Annulation de la CPA (`players.cpa_reversed_at`).
  cpaReversedAt       DateTime?
  lastEventAt         DateTime?
  raw                 Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  events PlayerEvent[]

  @@unique([affiliateCampaignId, externalPlayerId])
  @@index([subId])
  @@index([memberId])
  @@index([clickId])
  @@index([registeredAt])
  @@index([ftdAt])
  @@index([lastEventAt])
  @@index([createdAt])
  @@index([cpaCreditedAt])
  @@index([cpaReversedAt])
}

/// Événement joueur brut (inscription, FTD, dépôt, redépôt, NGR…).
model PlayerEvent {
  id         String          @id @default(cuid())
  playerId   String
  player     Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type       PlayerEventType
  amount     Decimal?        @db.Decimal(14, 2)
  currency   String?
  occurredAt DateTime
  /// Identifiant externe (unique par programme quand il existe).
  externalId String?
  raw        Json?
  createdAt  DateTime        @default(now())

  @@unique([playerId, externalId])
  @@index([playerId, occurredAt])
  @@index([type, occurredAt])
}

/// Curseur de synchronisation d'une source (une ligne par table Link Affi).
model SyncState {
  source        String    @id
  cursor        Json      @default("{}")
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  rowsImported  Int       @default(0)
  isRunning     Boolean   @default(false)
  updatedAt     DateTime  @updatedAt
}

/// Agrégat journalier Link Affi (table `stats`), phase 10 : source de la part de revshare, qui n'existe qu'en agrégat.
/// UNE LIGNE PAR LIGNE LINK AFFI (clé `externalId` = `stats.id`), pas une par (jour, offre) : Link Affi ajoute des lignes
/// de correction (CPA annulée, revshare repris, prime) datées du jour d'origine mais créées plus tard (`sourceCreatedAt`),
/// et certaines lignes n'ont pas d'offre (`campaign_id` vide). Lire en additionnant par (date, affiliateCampaignId).
/// La table `stats` couvre tous les affiliés de Link Affi : seules nos offres comptent (règle « nos joueurs »).
model AffiliateDailyStat {
  id                  String             @id @default(cuid())
  /// `stats.id` : clé d'upsert (synchro idempotente).
  externalId          String             @unique
  /// Jour de l'agrégat (`stats.date`, jour de Paris côté Link Affi).
  date                DateTime           @db.Date
  /// Offre Link Affi (`stats.campaign_id` → AffiliateCampaign.externalId) ; vide si la ligne n'a pas d'offre ou si
  /// l'offre n'est pas encore synchronisée.
  affiliateCampaignId String?
  affiliateCampaign   AffiliateCampaign? @relation(fields: [affiliateCampaignId], references: [id], onDelete: SetNull)
  /// `stats.campaign_id` brut, gardé même quand l'offre est inconnue chez nous (rattachement ultérieur).
  campaignExternalId  String?
  /// Programme (casino) : `stats.casino_id` → AffiliateProgram.externalId.
  programId           String?
  program             AffiliateProgram?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  programExternalId   String?
  /// `stats.affiliate_id` (affilié Link Affi).
  affiliateExternalId String?
  /// Volumes Link Affi (contrôle de cohérence avec nos propres chiffres ; `deposits` peut être négatif sur une correction).
  clicks              Int                @default(0)
  signups             Int                @default(0)
  deposits            Int                @default(0)
  depositAmount       Decimal            @default(0) @db.Decimal(14, 2)
  /// Commission totale de l'affilié (`stats.revenue`, arrondie au centime par Link Affi). Contient parfois des primes ou
  /// corrections manuelles absentes de `cpaRevenue` et `revshareRevenue`.
  revenue             Decimal            @default(0) @db.Decimal(14, 4)
  /// Part CPA de l'affilié (`stats.cpa_revenue`).
  cpaRevenue          Decimal            @default(0) @db.Decimal(14, 4)
  /// Part de revshare de l'affilié (`stats.revshare_revenue`, souvent fractionnaire, parfois négative).
  revshareRevenue     Decimal            @default(0) @db.Decimal(14, 4)
  /// Création de la ligne chez Link Affi (`stats.created_at`) : une correction est créée après le jour qu'elle corrige.
  sourceCreatedAt     DateTime?
  /// Ligne Link Affi complète (recalcul sans resynchroniser).
  raw                 Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([date])
  @@index([affiliateCampaignId, date])
  @@index([programId, date])
}

// ============================================================
// Phase 1 : pubs
// ============================================================

/// Pub (TikTok, Meta, autre) : regroupe liens d'entrée, canaux et campagnes d'affiliation.
model Campaign {
  id                   String               @id @default(cuid())
  name                 String
  vertical             Vertical?
  channelIds           Json                 @default("[]")
  affiliateCampaignIds Json                 @default("[]")
  adPlatform           AdPlatform?
  adExternalIds        Json?
  externalCampaignId   String?
  /// Compte publicitaire connecté par API qui alimente cette campagne (phase 7).
  connectionId         String?
  connection           AdAccountConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  budgetDaily          Decimal?             @db.Decimal(14, 2)
  currency             String               @default("EUR")
  tags                 Json                 @default("[]")
  startAt              DateTime?
  endAt                DateTime?
  status               CampaignStatus       @default(DRAFT)
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  inviteLinks   InviteLink[]
  trackingLinks TrackingLink[]
  adSets        AdSet[]
  costs         AdCost[]
  dailyStats    DailyStat[]
}

/// Groupe de pubs (adset / ad group) d'une campagne.
model AdSet {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ads   Ad[]
  costs AdCost[]

  @@unique([campaignId, name])
}

/// Pub précise (une pub = un lien d'entrée).
model Ad {
  id             String        @id @default(cuid())
  adSetId        String
  adSet          AdSet         @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  name           String
  externalId     String?
  inviteLinkId   String?       @unique
  inviteLink     InviteLink?   @relation(fields: [inviteLinkId], references: [id])
  trackingLinkId String?       @unique
  trackingLink   TrackingLink? @relation(fields: [trackingLinkId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  costs      AdCost[]
  dailyStats DailyStat[]

  @@unique([adSetId, name])
}

/// Coût publicitaire par jour, à un niveau (pub, groupe ou campagne) et pour une source.
model AdCost {
  id            String       @id @default(cuid())
  campaignId    String?
  campaign      Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSetId       String?
  adSet         AdSet?       @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  adId          String?
  ad            Ad?          @relation(fields: [adId], references: [id], onDelete: Cascade)
  /// Niveau concaténé pour l'unicité : "ad:<id>" | "adset:<id>" | "campaign:<id>".
  levelKey      String
  date          DateTime     @db.Date
  /// Dépense convertie en EUR (toutes les statistiques lisent cette colonne).
  spend         Decimal      @default(0) @db.Decimal(14, 2)
  /// Dépense dans la devise du compte (phase 7, API) ; null = saisie ou importée en EUR.
  spendOriginal Decimal?     @db.Decimal(14, 2)
  impressions   Int          @default(0)
  clicks        Int          @default(0)
  currency      String       @default("EUR")
  source        CostSource   @default(MANUAL)
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([levelKey, date, source])
  @@index([date])
}

/// Import de fichier (coûts, joueurs).
model ImportBatch {
  id          String     @id @default(cuid())
  kind        ImportKind
  filename    String
  rows        Int        @default(0)
  imported    Int        @default(0)
  errors      Json       @default("[]")
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  costs AdCost[]
}

/// Point d'entrée des postbacks directs d'un programme.
model PostbackEndpoint {
  id             String           @id @default(cuid())
  programId      String
  program        AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  name           String
  token          String           @unique
  /// Correspondance des paramètres reçus : { sub_id: "subid", player_id: "pid", event: "event", amount: "amount", currency: "currency", eventMap: { reg: "REGISTRATION", ... } }.
  mapping        Json             @default("{}")
  isActive       Boolean          @default(true)
  lastReceivedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  logs PostbackLog[]
}

/// Journal des postbacks reçus (append-only).
model PostbackLog {
  id            String           @id @default(cuid())
  endpointId    String
  endpoint      PostbackEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  receivedAt    DateTime         @default(now())
  ipHash        String?
  raw           Json             @default("{}")
  status        PostbackStatus   @default(ACCEPTED)
  message       String?
  playerEventId String?

  @@index([endpointId, receivedAt])
}

/// Envoi groupé ciblé (segment de membres).
model Broadcast {
  id           String          @id @default(cuid())
  name         String
  botId        String
  bot          Bot             @relation(fields: [botId], references: [id])
  /// Filtres du segment (JSON) : channelIds, spendLevels, inviteLinkIds, campaignIds, languages, inactiveDays, clickedCategoryIds…
  segment      Json            @default("{}")
  text         String
  buttons      Json            @default("[]")
  mediaAssetId String?
  mediaAsset   MediaAsset?     @relation(fields: [mediaAssetId], references: [id])
  status       BroadcastStatus @default(DRAFT)
  scheduledAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  targeted     Int             @default(0)
  sent         Int             @default(0)
  failed       Int             @default(0)
  blocked      Int             @default(0)
  lastError    String?
  /// Test A/B : identifiant commun aux variantes d'un même test et part (en %) des destinataires pour cette variante.
  abGroupId    String?
  abVariant    String?
  abSplit      Int?
  createdById  String?
  createdBy    User?           @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  outboundMessages OutboundMessage[]

  @@index([status, scheduledAt])
  @@index([abGroupId])
  @@index([createdAt])
}

/// Règle d'automatisation « si… alors… ».
model AutomationRule {
  id            String            @id @default(cuid())
  name          String
  trigger       AutomationTrigger
  /// Conditions (JSON) : channelIds, campaignIds, languages, spendLevels, inactiveDays, categoryIds…
  conditions    Json              @default("{}")
  /// Actions ordonnées (JSON) : [{ type: "send_message", text, buttons?, mediaAssetId?, botId? } | { type: "send_sequence", trigger } | { type: "wait", hours } | { type: "tag", tag } | { type: "suggest_channel", channelId } | { type: "notify_team", text }].
  actions       Json              @default("[]")
  /// Parcours à branches (JSON, `AutomationGraph` de packages/core/src/automation-graph.ts : { version: 1, nodes, edges }).
  /// Vide = règle linéaire (`actions`, exécutée comme avant) ; renseigné, il prime sur `actions`.
  graph         Json?
  /// Carte « prête à l'emploi » que la règle implémente (welcome, offer_no_signup, signup_no_deposit, inactive_7d,
  /// first_deposit_thanks, vip) ; vide = relance sur mesure.
  templateKey   String?
  isActive      Boolean           @default(false)
  /// Une seule exécution par membre et par règle (sauf si false).
  oncePerMember Boolean           @default(true)
  runs          Int               @default(0)
  lastRunAt     DateTime?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  executions       AutomationRun[]
  trackingLinks    TrackingLink[]
  outboundMessages OutboundMessage[]

  @@index([trigger, isActive])
}

/// Exécution d'une règle pour un membre (journal + file des étapes différées).
model AutomationRun {
  id        String              @id @default(cuid())
  ruleId    String
  rule      AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    AutomationRunStatus @default(PENDING)
  /// Règle linéaire : index de la prochaine action à exécuter. Graphe : nombre de blocs déjà parcourus.
  step      Int                 @default(0)
  /// Graphe : bloc courant (prochain bloc après une attente, bloc en erreur, dernier bloc parcouru une fois terminée).
  /// Vide pour une règle linéaire.
  nodeId    String?
  /// Reprise des étapes « attendre ».
  resumeAt  DateTime?
  context   Json                @default("{}")
  log       Json                @default("[]")
  error     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([ruleId, memberId, createdAt])
  @@index([status, resumeAt])
  @@index([memberId])
}

/// Alerte système (bot en erreur, synchro en échec, file engorgée…).
model Alert {
  id         String        @id @default(cuid())
  kind       String
  severity   AlertSeverity @default(WARNING)
  message    String
  payload    Json          @default("{}")
  createdAt  DateTime      @default(now())
  notifiedAt DateTime?
  resolvedAt DateTime?

  @@index([kind, createdAt])
  @@index([resolvedAt])
}

/// Statistiques journalières pré-calculées (par canal, pub, campagne ou univers ; une ligne par combinaison).
model DailyStat {
  id                  String    @id @default(cuid())
  date                DateTime  @db.Date
  /// Clé de dimension : "all" | "channel:<id>" | "campaign:<id>" | "ad:<id>" | "vertical:<V>".
  dimension           String
  channelId           String?
  channel             Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  campaignId          String?
  campaign            Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adId                String?
  ad                  Ad?       @relation(fields: [adId], references: [id], onDelete: Cascade)
  vertical            Vertical?
  requests            Int       @default(0)
  approved            Int       @default(0)
  joined              Int       @default(0)
  left                Int       @default(0)
  entryClicks         Int       @default(0)
  offerClicks         Int       @default(0)
  registrations       Int       @default(0)
  ftds                Int       @default(0)
  deposits            Int       @default(0)
  depositAmount       Decimal   @default(0) @db.Decimal(14, 2)
  ngr                 Decimal   @default(0) @db.Decimal(14, 2)
  spend               Decimal   @default(0) @db.Decimal(14, 2)
  /// Phase 10 : nos commissions du jour en EUR (CPA nette + part de revshare). Gains = commissions − spend ; jamais
  /// les dépôts ni le revenu net (argent du casino).
  commissions         Decimal   @default(0) @db.Decimal(14, 2)
  /// Détail : CPA créditées − CPA annulées, chacune au jour réel (événements CPA / CPA_REVERSAL).
  cpaCommissions      Decimal   @default(0) @db.Decimal(14, 2)
  /// Détail : part de revshare (agrégat Link Affi `AffiliateDailyStat` de nos offres).
  revshareCommissions Decimal   @default(0) @db.Decimal(14, 2)
  updatedAt           DateTime  @updatedAt

  @@unique([date, dimension])
  @@index([dimension, date])
}

/// Note interne sur un membre.
model MemberNote {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

// ============================================================
// Phase 7 : connecteurs directs (Meta, TikTok) et vues Telegram
// ============================================================

/// Identifiants d'application développeur par plateforme (une ligne par plateforme ; secret chiffré AES-256-GCM).
model ConnectorApp {
  platform        AdPlatform @id
  clientId        String
  secretEncrypted String
  /// Options par plateforme (JSON) : Meta `configId`, TikTok `sandbox`, Telegram `apiId`…
  extra           Json       @default("{}")
  verifiedAt      DateTime?
  lastError       String?
  updatedById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

/// Compte publicitaire connecté par OAuth (plusieurs par plateforme, par utilisateur).
model AdAccountConnection {
  id                    String           @id @default(cuid())
  platform              AdPlatform
  /// Identifiant chez la plateforme : Meta `act_<id>`, TikTok `advertiser_id`.
  externalId            String
  name                  String
  currency              String           @default("EUR")
  timezone              String?
  businessName          String?
  status                ConnectionStatus @default(ACTIVE)
  tokenEncrypted        String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scopes                String?
  connectedById         String?
  connectedBy           User?            @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  lastSyncAt            DateTime?
  lastSyncRows          Int              @default(0)
  lastError             String?
  /// Prochaine resynchronisation longue (28 jours), une fois par nuit.
  nextFullSyncAt        DateTime?
  /// Historique initial (90 jours) déjà chargé.
  backfilledAt          DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  campaigns Campaign[]
  runs      ConnectorSyncRun[]

  @@unique([platform, externalId])
  @@index([status])
}

/// Journal d'une synchronisation de dépenses (visible dans Réglages → Connecteurs).
model ConnectorSyncRun {
  id           String              @id @default(cuid())
  connectionId String
  connection   AdAccountConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?
  dateFrom     DateTime            @db.Date
  dateTo       DateTime            @db.Date
  rows         Int                 @default(0)
  /// running | ok | error
  status       String              @default("running")
  error        String?

  @@index([connectionId, startedAt])
}

/// Session utilisateur Telegram (MTProto) pour lire les vues des messages : une seule ligne (`main`).
model TelegramUserSession {
  id               String    @id @default("main")
  phone            String
  /// Session GramJS (StringSession) chiffrée.
  sessionEncrypted String
  /// PENDING_CODE | PENDING_PASSWORD | ACTIVE | ERROR | DISCONNECTED
  status           String    @default("PENDING_CODE")
  phoneCodeHash    String?
  connectedById    String?
  lastUsedAt       DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Relevé des vues et transferts d'un message de canal (pour les courbes).
model PostViewSample {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  at       DateTime @default(now())
  views    Int      @default(0)
  forwards Int      @default(0)

  @@index([postId, at])
}

// ============================================================
// Phase 8 : assistant IA d'écriture des messages
// ============================================================

/// Suggestion produite par l'assistant IA d'écriture (phase 8) : brouillon d'entrée, 3 versions proposées, jetons et coût estimé.
/// `kind` : improve | idea | shorter | punchier | angle | translate | ab_variant. `context` : univers, catégorie, langue,
/// objectif, ton, longueur, média, surface (post | bot_text | broadcast | template | automation). `usedIndex` : version retenue.
model AiSuggestion {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  kind         String
  context      Json     @default("{}")
  input        String
  /// Versions proposées (JSON : `{ text, why }[]`, ou pour `translate` une entrée par langue).
  outputs      Json     @default("[]")
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  costEur      Decimal  @default(0) @db.Decimal(10, 4)
  usedIndex    Int?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ============================================================
// Phase 13 : campagnes Telegram des affiliés Link Affi (docs/LINKAFFI-PARTENAIRES.md)
// ============================================================

/// État d'un événement à envoyer à Link Affi (fonction `telegram-events`).
enum LinkaffiEventStatus {
  /// À envoyer (ou nouvel essai prévu à `nextAttemptAt`).
  PENDING
  /// Reçu par Link Affi (réponse 2xx).
  SENT
  /// Abandonné après 24 h de tentatives (Link Affi peut le rattraper par `GET /members`).
  FAILED
}

/// Événement d'un membre d'affilié à envoyer à Link Affi : `join_requested`, `join_approved`, `join_declined`,
/// `join_expired`, `joined`, `left`, `offer_clicked`. Corps exact du contrat dans `body` (JSON), signé HMAC-SHA256 à
/// l'envoi avec le secret de `IntegrationKey`. `eventId` unique et déterministe : un doublon n'est jamais créé ni
/// envoyé deux fois ; Link Affi ignore de toute façon un `eventId` déjà reçu.
model LinkaffiEvent {
  id            String              @id @default(cuid())
  eventId       String              @unique
  type          String
  occurredAt    DateTime
  campaignKey   String
  memberId      String?
  channelId     String?
  /// Corps envoyé (contrat § 2), tel quel.
  body          Json
  status        LinkaffiEventStatus @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  lastError     String?
  lastStatus    Int?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([campaignKey, occurredAt])
  @@index([memberId])
}

/// Clés de l'intégration Link Affi (une ligne, `provider` = "linkaffi") : clé d'API que Link Affi envoie à notre API
/// d'intégration (stockée hachée SHA-256, affichée une seule fois à la génération) et secret de signature des
/// événements (chiffré AES-256-GCM avec APP_ENCRYPTION_KEY), adresse de la fonction `telegram-events`.
model IntegrationKey {
  provider               String    @id
  apiKeyHash             String?   @unique
  /// Début de la clé (affiché pour la reconnaître, jamais la clé entière).
  apiKeyPrefix           String?
  apiKeyCreatedAt        DateTime?
  apiKeyCreatedById      String?
  webhookSecretEncrypted String?
  webhookSecretCreatedAt DateTime?
  /// Adresse de la fonction Link Affi qui reçoit les événements (modifiable).
  eventsUrl              String?
  lastApiCallAt          DateTime?
  lastEventSentAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}
