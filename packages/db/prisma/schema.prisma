// Schéma de données LinkAffi Pro — phases 0 et 1.
// Noms en anglais, commentaires en français. Documentation : docs/DATA-MODEL.md.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

/// Rôle d'un utilisateur interne.
enum Role {
  ADMIN
  MANAGER
}

/// Univers d'affiliation.
enum Vertical {
  CASINO
  SPORTS
  DATING
}

/// Type de conversation Telegram.
enum ChatType {
  CHANNEL
  GROUP
}

/// Statut d'une demande d'adhésion.
enum MembershipStatus {
  REQUESTED
  PENDING_GATE
  SCHEDULED
  APPROVED
  DECLINED
  LEFT
  KICKED
  EXPIRED
  FAILED
}

/// Mode d'approbation d'une règle.
enum ApprovalMode {
  IMMEDIATE
  DELAY
  MANUAL
}

/// Exigence des canaux à rejoindre d'abord.
enum GateMode {
  NONE
  REQUIRED
  SOFT
}

/// Action à l'expiration d'une demande.
enum ExpireAction {
  DECLINE
  APPROVE
  KEEP
}

/// Nature d'un lien d'invitation.
enum InviteLinkKind {
  AD_ENTRY
  GATE
  MANUAL
  /// Lien de partage créé depuis la fiche du canal (phase 11), nommé, avec demande d'adhésion, à poster où l'on veut
  /// (`sourceChannelId` facultatif : « à poster dans <canal> »).
  SHARE
  /// Lien d'une campagne Telegram d'affilié créée DANS Link Affi (phase 13, docs/LINKAFFI-PARTENAIRES.md) : demandé
  /// par Link Affi via l'API d'intégration (`POST /invite-links`), avec demande d'adhésion ; `linkaffi.me/go/<clé>`
  /// redirige vers lui. Les personnes entrées par ce lien sont rattachées à l'affilié (premier affilié gagne).
  LINKAFFI
  /// Lien d'une source d'une page d'atterrissage (phase 15, `landingPageId` + `landingSource`), avec demande
  /// d'adhésion, créé par le bot de l'univers du canal (repli sur un autre de nos bots administrateurs). Nom
  /// « <page>-<source> » tronqué à 32 caractères.
  LANDING
}

/// Qui publie un message de canal (phase 12). Telegram interdit les emojis animés (emojis personnalisés des packs
/// Premium) aux bots dans les canaux : un message de canal qui en contient est publié par le compte Telegram connecté
/// (MTProto, Réglages → Connecteurs → Telegram), sans boutons.
enum PostPublisher {
  /// Le bot du message (Bot API), comme avant la phase 12.
  BOT
  /// Le compte Telegram Premium connecté (TelegramUserSession), pour un message avec emojis animés.
  ACCOUNT
}

/// D'où vient un emoji animé de la bibliothèque (phase 12).
enum CustomEmojiSource {
  /// Message transféré (ou envoyé) au bot par un membre de l'équipe.
  FORWARD
  /// Lien d'un pack collé dans le site (t.me/addemoji/<nom>).
  PACK
  /// Packs installés sur le compte Telegram connecté.
  ACCOUNT
}

/// Portée d'une règle d'adhésion (phase 11) : règle par défaut du canal, ou exception selon la provenance.
/// Résolution, du plus précis au plus général : INVITE_LINK → SOURCE_CHANNEL → SOURCE_KIND → DEFAULT
/// (fonction pure `pickRuleForProvenance` de packages/core/src/provenance.ts).
enum ApprovalRuleScope {
  /// Règle par défaut du canal (`isDefault = true`).
  DEFAULT
  /// Exception d'un lien d'invitation précis (`inviteLinkId`).
  INVITE_LINK
  /// Exception pour les personnes venues d'un de nos canaux (`sourceChannelId` du lien GATE ou SHARE).
  SOURCE_CHANNEL
  /// Exception pour un type de provenance (`sourceKind`).
  SOURCE_KIND
}

/// Type de provenance d'une exception `SOURCE_KIND` (phase 11).
enum ApprovalSourceKind {
  /// Venue du bouton « canal à rejoindre » (obligatoire) d'un de nos canaux (lien GATE).
  GATE
  /// Venue de n'importe lequel de nos canaux (lien GATE, ou lien SHARE posté dans un de nos canaux).
  ANY_CHANNEL
  /// Venue de n'importe quelle pub (lien d'entrée AD_ENTRY).
  AD_ANY
  /// Venue d'une pub TikTok (lien d'entrée AD_ENTRY, plateforme TIKTOK).
  AD_TIKTOK
  /// Venue d'une pub Meta (lien d'entrée AD_ENTRY, plateforme META).
  AD_META
  /// Venue de n'importe quel lien de partage (SHARE).
  SHARE
  /// Venue de n'importe quelle campagne Telegram d'affilié Link Affi (lien LINKAFFI, phase 13).
  LINKAFFI_ANY
  /// Venue d'une campagne d'un affilié Link Affi précis (`ApprovalRule.linkaffiAffiliateId`, phase 13).
  LINKAFFI_AFFILIATE
  /// Venue de n'importe quelle page d'atterrissage (lien LANDING, phase 15).
  LANDING_ANY
  /// Venue d'une page d'atterrissage précise (`ApprovalRule.landingPageId`, phase 15), toutes sources.
  LANDING_PAGE
}

/// Plateforme publicitaire.
enum AdPlatform {
  TIKTOK
  META
  OTHER
}

/// État d'une connexion à un compte publicitaire (phase 7).
enum ConnectionStatus {
  ACTIVE
  NEEDS_RECONNECT
  DISABLED
}

/// Nature d'un lien traqué goolink.
enum TrackingLinkKind {
  AD_ENTRY
  OFFER
  BUTTON
  GENERIC
}

/// Statut d'un message programmé.
enum PostStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  DELETED
  CANCELLED
}

/// Déclencheur d'une séquence de messages privés.
enum SequenceTrigger {
  JOIN_REQUEST
  GATE_REMINDER
  GATE_SATISFIED
  APPROVED
  START
  OFFER_REPLY
}

/// Nature d'un message privé sortant.
enum OutboundKind {
  WELCOME
  GATE_REMINDER
  ACCEPTED
  OFFER_REPLY
  BROADCAST
  AUTOMATION
  TEST
  /// Phase 17 : message de l'assistant de conversation (ou de l'équipe dans une conversation reprise en main).
  ASSISTANT
}

/// Statut d'un message privé sortant.
enum OutboundStatus {
  QUEUED
  SENT
  FAILED
  BLOCKED
}

/// Origine des données d'un programme d'affiliation.
enum AffiliateSource {
  LINKAFFI
  CSV
  API
}

/// Type d'événement joueur.
/// Phase 10 : CPA = commission CPA créditée (part affilié, montant POSITIF, datée `players.cpa_credited_at`) ;
/// CPA_REVERSAL = annulation de cette commission (montant NÉGATIF, datée `players.cpa_reversed_at`). La somme des deux
/// sur une période donne la CPA nette : une CPA annulée se retranche le jour de l'annulation.
enum PlayerEventType {
  CLICK
  REGISTRATION
  FTD
  DEPOSIT
  REDEPOSIT
  NGR
  OTHER
  CPA
  CPA_REVERSAL
}

/// Statut d'une pub / campagne publicitaire.
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

/// Origine d'une ligne de coût publicitaire.
enum CostSource {
  CSV
  MANUAL
  API
}

/// Nature d'un import de fichier.
enum ImportKind {
  TIKTOK_CSV
  META_CSV
  COSTS_MANUAL
  PLAYERS_CSV
}

/// Statut d'un postback reçu.
enum PostbackStatus {
  ACCEPTED
  IGNORED
  ERROR
}

/// Statut d'un envoi groupé.
enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

/// Déclencheur d'une automatisation.
enum AutomationTrigger {
  JOINED
  OFFER_CLICKED
  REGISTERED
  DEPOSITED
  INACTIVE
  LEFT
  SPEND_LEVEL_REACHED
}

/// Statut d'une exécution d'automatisation.
enum AutomationRunStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
  CANCELLED
}

/// Gravité d'une alerte.
enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// ============================================================
// Phase 0 : utilisateurs, bots, canaux, membres, événements
// ============================================================

/// Utilisateur interne (admin ou manager). Pas d'inscription publique.
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  role              Role      @default(MANAGER)
  isActive          Boolean   @default(true)
  /// Identifiant Telegram lié via « Mon compte » (optionnel).
  telegramUserId    BigInt?   @unique
  /// Jeton temporaire pour lier le compte Telegram (t.me/<bot>?start=admin_<token>).
  telegramLinkToken String?   @unique
  /// Version de session : incrémentée au changement de mot de passe, de rôle ou à la désactivation.
  /// Le JWT porte la version émise (`sv`) ; si elle diffère, la session est refusée (déconnexion de tous les appareils).
  sessionVersion    Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  invitationsSent      Invitation[]          @relation("InvitedBy")
  auditLogs            AuditLog[]
  inviteLinks          InviteLink[]
  trackingLinks        TrackingLink[]
  mediaAssets          MediaAsset[]
  postsCreated         Post[]                @relation("PostCreatedBy")
  postsUpdated         Post[]                @relation("PostUpdatedBy")
  memberNotes          MemberNote[]
  importBatches        ImportBatch[]
  broadcasts           Broadcast[]
  adAccountConnections AdAccountConnection[]
  aiSuggestions        AiSuggestion[]
  customEmojis         CustomEmoji[]
  landingPages         LandingPage[]
  personasCreated      Persona[]
  conversationsTaken   Conversation[]
  conversationMessages ConversationMessage[]
}

/// Invitation à rejoindre l'équipe, créée par un ADMIN.
model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(MANAGER)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([email])
}

/// Journal des actions des utilisateurs (append-only).
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
}

/// Bot Telegram piloté par la plateforme. Le jeton est chiffré (AES-256-GCM).
model Bot {
  userbotAccounts TelegramUserAccount[]
  id              String                @id @default(cuid())
  name            String
  username        String                @unique
  telegramBotId   BigInt                @unique
  tokenEncrypted  String
  vertical        Vertical
  isActive        Boolean               @default(true)
  /// Secret attendu dans l'en-tête X-Telegram-Bot-Api-Secret-Token.
  webhookSecret   String
  lastWebhookAt   DateTime?
  lastError       String?
  /// Phase 17 : bot normal (STANDARD) ou assistant de conversation (ASSISTANT, persona liée). Un bot ASSISTANT n'est
  /// jamais choisi automatiquement (bot principal, liens, relances, envois à un groupe).
  mode            BotMode               @default(STANDARD)
  personaId       String?
  persona         Persona?              @relation(fields: [personaId], references: [id], onDelete: SetNull)
  /// Phase 26 : bot de canal (CHANNEL) ou Boss (ADMIN, dialogue avec l'admin seulement). Un bot ADMIN n'est jamais
  /// choisi pour un canal, un lien, une séquence, un envoi, une page, un compte réel, ni mis en mode ASSISTANT.
  role            BotRole               @default(CHANNEL)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  channelAdmins      ChannelBotAdmin[]
  memberStates       MemberBotState[]
  primaryChannels    Channel[]                @relation("PrimaryBot")
  events             Event[]
  inviteLinks        InviteLink[]
  memberships        Membership[]             @relation("ApprovedByBot")
  clicks             Click[]
  posts              Post[]
  sequences          Sequence[]
  outboundMessages   OutboundMessage[]
  mediaTelegramFiles MediaAssetTelegramFile[]
  broadcasts         Broadcast[]
  conversations      Conversation[]
  assistantOffers    AssistantOfferLink[]

  @@index([mode])
}

/// Canal (ou groupe) Telegram détecté automatiquement.
model Channel {
  id                    String               @id @default(cuid())
  telegramChatId        BigInt               @unique
  title                 String
  username              String?
  type                  ChatType             @default(CHANNEL)
  vertical              Vertical?
  language              String               @default("fr")
  primaryBotId          String?
  primaryBot            Bot?                 @relation("PrimaryBot", fields: [primaryBotId], references: [id])
  isActive              Boolean              @default(true)
  isTest                Boolean              @default(false)
  isMediaLibrary        Boolean              @default(false)
  settings              Json                 @default("{}")
  /// Petite photo du canal (JPEG 160 px de Telegram, `getChat` → `small_file_id`), pour les pages d'atterrissage qui
  /// l'affichent (phase 15). `photoFileUniqueId` : photo actuelle chez Telegram (rien à retélécharger s'il ne change pas).
  photoSmall            Bytes?
  photoFileUniqueId     String?
  /// Dernière relecture du titre et de la photo par `getChat` (phase 15, canaux qui ont une page d'atterrissage).
  chatCheckedAt         DateTime?
  /// DM de bienvenue envoye par un COMPTE REEL (userbot) a l'acceptation d'une demande. Independant du message
  /// d'accueil du bot (`ApprovalRule.sendWelcome`) : les deux coexistent. Le compte doit etre membre du canal.
  welcomeDmEnabled      Boolean              @default(false)
  welcomeDmAccountId    String?
  welcomeDmAccount      TelegramUserAccount? @relation("WelcomeDmAccount", fields: [welcomeDmAccountId], references: [id], onDelete: SetNull)
  /// Minutes d'attente apres l'acceptation avant l'envoi.
  welcomeDmDelayMinutes Int                  @default(30)
  welcomeDmText         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  botAdmins     ChannelBotAdmin[]
  landingPages  LandingPage[]
  events        Event[]
  memberships   Membership[]
  approvalRules ApprovalRule[]
  accountDms    AccountDm[]
  inviteLinks   InviteLink[]
  trackingLinks TrackingLink[]
  posts         Post[]
  sequences     Sequence[]
  dailyStats    DailyStat[]
  agentPlan     ChannelAgentPlan?
  agentMissions AgentMission[]
  mediaUsages   MediaUsage[]
}

/// Droits d'administrateur d'un bot sur un canal.
model ChannelBotAdmin {
  id         String    @id @default(cuid())
  channelId  String
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  botId      String
  bot        Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  rights     Json      @default("{}")
  detectedAt DateTime  @default(now())
  revokedAt  DateTime?

  @@unique([channelId, botId])
}

/// Membre Telegram vu par au moins un bot.
model Member {
  id                         String      @id @default(cuid())
  telegramUserId             BigInt      @unique
  firstName                  String?
  lastName                   String?
  username                   String?
  languageCode               String?
  isPremium                  Boolean     @default(false)
  firstSeenAt                DateTime    @default(now())
  lastSeenAt                 DateTime    @default(now())
  /// Anonymisé (suppression sur demande) : identité effacée, événements conservés sans données personnelles.
  anonymizedAt               DateTime?
  /// Étiquettes libres (JSON : string[]).
  tags                       Json        @default("[]")
  /// Affilié Link Affi qui a amené ce membre (phase 13) : premier affilié gagne, jamais écrasé automatiquement ;
  /// changé ou retiré seulement par un ADMIN (journal). `affiliateAttributionEndsAt` : fin de l'attribution si la
  /// campagne a une durée (null = à vie).
  linkaffiCampaignKey        String?
  linkaffiAffiliateId        String?
  affiliateAttributedAt      DateTime?
  affiliateAttributionEndsAt DateTime?
  affiliateInviteLinkId      String?
  affiliateInviteLink        InviteLink? @relation("AffiliateInviteLink", fields: [affiliateInviteLinkId], references: [id], onDelete: SetNull)

  botStates        MemberBotState[]
  events           Event[]
  memberships      Membership[]
  clicks           Click[]
  players          Player[]
  outboundMessages OutboundMessage[]
  notes            MemberNote[]
  automationRuns   AutomationRun[]
  conversations    Conversation[]
  assistantOffers  AssistantOfferLink[]

  @@index([linkaffiAffiliateId])
  @@index([linkaffiCampaignKey])
  @@index([lastSeenAt])
  @@index([firstSeenAt])
  @@index([anonymizedAt, lastSeenAt])
}

/// État de la relation entre un membre et un bot (peut-on lui écrire en privé ?).
model MemberBotState {
  id        String    @id @default(cuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  canDm     Boolean   @default(false)
  startedAt DateTime?
  blockedAt DateTime?
  lastDmAt  DateTime?

  @@unique([memberId, botId])
  @@index([botId, canDm])
}

/// Journal d'événements (append-only : jamais de mise à jour ni de suppression dans le code).
model Event {
  id         String   @id @default(cuid())
  type       String
  occurredAt DateTime @default(now())
  memberId   String?
  member     Member?  @relation(fields: [memberId], references: [id])
  channelId  String?
  channel    Channel? @relation(fields: [channelId], references: [id])
  botId      String?
  bot        Bot?     @relation(fields: [botId], references: [id])
  payload    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([type, occurredAt])
  @@index([memberId, occurredAt])
  @@index([channelId, occurredAt])
  @@index([botId, occurredAt])
  @@index([occurredAt])
}

/// Réglage global (clé → valeur JSON).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ============================================================
// Phase 1 : adhésions
// ============================================================

/// Demande d'adhésion d'un membre à un canal. Un enregistrement par demande (un membre qui revient en crée un nouveau).
/// Code court pour les liens profonds `/start g<code>`.
model Membership {
  id              String           @id @default(cuid())
  code            String           @unique
  memberId        String
  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  channelId       String
  channel         Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  status          MembershipStatus @default(REQUESTED)
  inviteLinkId    String?
  inviteLink      InviteLink?      @relation(fields: [inviteLinkId], references: [id])
  approvalRuleId  String?
  approvalRule    ApprovalRule?    @relation(fields: [approvalRuleId], references: [id])
  /// Identifiant du chat privé fourni par Telegram dans chat_join_request (user_chat_id).
  userChatId      BigInt?
  requestedAt     DateTime         @default(now())
  gateSatisfiedAt DateTime?
  approveAt       DateTime?
  approvedAt      DateTime?
  declinedAt      DateTime?
  joinedAt        DateTime?
  leftAt          DateTime?
  expiresAt       DateTime?
  approvedByBotId String?
  approvedByBot   Bot?             @relation("ApprovedByBot", fields: [approvedByBotId], references: [id])
  /// Instantané de la source : lien, pub, campagne (JSON). Phase 11 : `provenance` = provenance résolue
  /// `{ type, sourceChannelId, inviteLinkId, adPlatform, label }` et `appliedRule` = règle appliquée
  /// `{ id, scope, label, noGates? }` (voir docs/DATA-MODEL.md).
  source          Json             @default("{}")
  remindersSent   Int              @default(0)
  lastReminderAt  DateTime?
  attempts        Int              @default(0)
  lastError       String?
  updatedAt       DateTime         @updatedAt

  @@unique([memberId, channelId, requestedAt])
  @@index([channelId, status])
  @@index([status, approveAt])
  @@index([status, expiresAt])
  @@index([memberId, channelId])
  @@index([channelId, requestedAt])
  @@index([inviteLinkId, requestedAt])
  @@index([requestedAt])
  @@index([approvedAt])
  @@index([joinedAt])
  @@index([leftAt])
}

/// Règle d'approbation d'un canal : règle par défaut (`scope = DEFAULT`, `isDefault = true`) ou exception selon la
/// provenance (phase 11 : `scope` INVITE_LINK / SOURCE_CHANNEL / SOURCE_KIND, `isDefault = false`).
model ApprovalRule {
  id                   String              @id @default(cuid())
  channelId            String
  channel              Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name                 String
  isDefault            Boolean             @default(false)
  /// Portée de la règle (phase 11). Les règles d'avant la phase 11 : DEFAULT, ou INVITE_LINK si `inviteLinkId`.
  scope                ApprovalRuleScope   @default(DEFAULT)
  /// Règle spécifique à un lien d'invitation (`scope = INVITE_LINK`, sinon règle du canal).
  inviteLinkId         String?             @unique
  inviteLink           InviteLink?         @relation("RuleForLink", fields: [inviteLinkId], references: [id])
  /// Canal d'où vient la personne (`scope = SOURCE_CHANNEL`) : `sourceChannelId` du lien GATE ou SHARE. Pas de clé
  /// étrangère (comme `InviteLink.sourceChannelId`) : un canal supprimé laisse une exception affichée « canal supprimé ».
  sourceChannelId      String?
  /// Type de provenance (`scope = SOURCE_KIND`).
  sourceKind           ApprovalSourceKind?
  /// Affilié Link Affi visé par une exception `SOURCE_KIND` = LINKAFFI_AFFILIATE (phase 13 ; identifiant Link Affi).
  linkaffiAffiliateId  String?
  /// Page d'atterrissage visée par une exception `SOURCE_KIND` = LANDING_PAGE (phase 15). Pas de clé étrangère (comme
  /// `sourceChannelId`) : une page supprimée laisse une exception affichée « page supprimée ».
  landingPageId        String?
  /// Texte lisible de l'exception (« Venu de Tir Cadré »), recalculé à l'enregistrement.
  label                String?
  /// Ordre des exceptions de même niveau (ordre choisi par l'équipe, du plus petit au plus grand).
  sortOrder            Int                 @default(0)
  /// Message privé envoyé à l'arrivée de la demande (accueil, ou court message pour une personne venue d'un canal
  /// obligatoire). Toujours envoyé quand des canaux sont à rejoindre (sinon la personne resterait bloquée).
  sendWelcome          Boolean             @default(true)
  mode                 ApprovalMode        @default(DELAY)
  delaySeconds         Int                 @default(0)
  /// Liste d'identifiants de canaux à rejoindre d'abord (JSON : string[]).
  gateChannelIds       Json                @default("[]")
  gateMode             GateMode            @default(NONE)
  /// Minutes après la demande pour chaque rappel (JSON : number[]), ex. [60, 1440].
  reminderAfterMinutes Json                @default("[60, 1440]")
  maxReminders         Int                 @default(2)
  expireAfterHours     Int?
  expireAction         ExpireAction        @default(KEEP)
  sendAcceptedMessage  Boolean             @default(true)
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  memberships Membership[]

  @@index([channelId, isDefault])
  @@index([channelId, scope, isActive])
}

/// Lien d'invitation Telegram créé par la plateforme (entrée par pub, gate, manuel).
model InviteLink {
  id                    String         @id @default(cuid())
  channelId             String
  channel               Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  botId                 String
  bot                   Bot            @relation(fields: [botId], references: [id])
  telegramInviteLink    String         @unique
  name                  String
  kind                  InviteLinkKind @default(AD_ENTRY)
  createsJoinRequest    Boolean        @default(true)
  campaignId            String?
  campaign              Campaign?      @relation(fields: [campaignId], references: [id])
  adPlatform            AdPlatform?
  adCampaignName        String?
  adSetName             String?
  adName                String?
  adExternalIds         Json?
  /// Canal source pour un lien GATE (d'où vient le membre), ou canal où poster un lien SHARE (facultatif).
  sourceChannelId       String?
  /// Campagne Telegram d'affilié créée dans Link Affi (kind LINKAFFI, phase 13) : clé du lien de l'affilié
  /// (`linkaffi.me/go/<clé>`), nom de la campagne, affilié, durée d'attribution en jours (null = à vie).
  /// Idempotence de `POST /invite-links` : même clé + même canal = même lien.
  linkaffiCampaignKey   String?
  linkaffiCampaignName  String?
  linkaffiAffiliateId   String?
  linkaffiAffiliateName String?
  attributionDays       Int?
  /// Page d'atterrissage (kind LANDING, phase 15) et clé de sa source (« tk01 » ; "" = lien par défaut de la page,
  /// sans `?src=`). Un lien révoqué garde sa page et sa source (les anciennes demandes restent rattachées).
  landingPageId         String?
  landingPage           LandingPage?   @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  landingSource         String?
  /// Pub pour laquelle ce lien LANDING a été créé (pub reliée à la source à ce moment-là), figée : ses demandes comptent
  /// pour cette pub et sa campagne (`campaignId`, posée à la création) pour toujours. La pub d'une source change : un
  /// nouveau lien est créé, l'ancien garde sa pub. Page supprimée : le lien garde sa pub. Pub supprimée : null, le lien
  /// garde sa campagne (comme un lien d'entrée direct).
  landingAdId           String?
  landingAd             Ad?            @relation("LandingAdLinks", fields: [landingAdId], references: [id], onDelete: SetNull)
  language              String         @default("fr")
  isActive              Boolean        @default(true)
  createdById           String?
  createdBy             User?          @relation(fields: [createdById], references: [id])
  /// Compteurs dénormalisés.
  requests              Int            @default(0)
  approved              Int            @default(0)
  joined                Int            @default(0)
  left                  Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  memberships      Membership[]
  affiliateMembers Member[]       @relation("AffiliateInviteLink")
  trackingLinks    TrackingLink[]
  rule             ApprovalRule?  @relation("RuleForLink")
  ad               Ad?            @relation("AdInviteLink")
  landingSourceOf  LandingSource? @relation("LandingSourceLink")

  @@unique([linkaffiCampaignKey, channelId])
  @@index([landingPageId, landingSource])
  @@index([landingAdId])
  @@index([linkaffiAffiliateId])
  @@index([channelId, kind])
  @@index([kind, createdAt])
  @@index([campaignId])
}

// ============================================================
// Phase 1 : liens traqués et clics
// ============================================================

/// Lien court goolink (slug base62 de 6 à 10 caractères).
model TrackingLink {
  id                  String             @id @default(cuid())
  slug                String             @unique
  kind                TrackingLinkKind   @default(GENERIC)
  /// URL de destination avec placeholders {subid}, {click_id}, {member_id}, {post_id}.
  destinationTemplate String
  label               String
  inviteLinkId        String?
  inviteLink          InviteLink?        @relation(fields: [inviteLinkId], references: [id])
  channelId           String?
  channel             Channel?           @relation(fields: [channelId], references: [id])
  campaignId          String?
  campaign            Campaign?          @relation(fields: [campaignId], references: [id])
  affiliateCampaignId String?
  affiliateCampaign   AffiliateCampaign? @relation(fields: [affiliateCampaignId], references: [id])
  postId              String?
  post                Post?              @relation(fields: [postId], references: [id])
  /// Relance automatique qui a envoyé ce bouton (Offre ou lien traqué d'un message de relance), comme `postId` pour un
  /// message de canal (phase 10). Relance supprimée : le lien reste utilisable, le rattachement est effacé.
  automationRuleId    String?
  automationRule      AutomationRule?    @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)
  /// Phase 17 : lien OFFER stable d'une persona de l'assistant de conversation (slug déterministe). Persona supprimée :
  /// le lien reste utilisable, le rattachement est effacé.
  personaId           String?
  persona             Persona?           @relation(fields: [personaId], references: [id], onDelete: SetNull)
  isActive            Boolean            @default(true)
  createdById         String?
  createdBy           User?              @relation(fields: [createdById], references: [id])
  /// Compteurs dénormalisés (humains seulement).
  clicks              Int                @default(0)
  uniqueClicks        Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  clickRecords    Click[]
  ad              Ad?
  assistantOffers AssistantOfferLink[]

  @@index([kind, isActive])
  @@index([postId])
  @@index([kind, createdAt])
  @@index([inviteLinkId])
  @@index([channelId])
  @@index([affiliateCampaignId])
  @@index([automationRuleId])
  @@index([personaId])
}

/// Clic sur un lien traqué ou un bouton. `subId` unique pour les clics OFFER (12 caractères base62, sans point).
model Click {
  id                          String        @id @default(cuid())
  trackingLinkId              String
  trackingLink                TrackingLink  @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  subId                       String?       @unique
  memberId                    String?
  member                      Member?       @relation(fields: [memberId], references: [id])
  postId                      String?
  post                        Post?         @relation(fields: [postId], references: [id])
  botId                       String?
  bot                         Bot?          @relation(fields: [botId], references: [id])
  ipHash                      String?
  userAgent                   String?
  isBot                       Boolean       @default(false)
  referer                     String?
  country                     String?
  ttclid                      String?
  fbclid                      String?
  gclid                       String?
  utm                         Json?
  /// URL finale envoyée au membre (offres), pour diagnostic.
  destination                 String?
  /// Campagne Telegram d'affilié Link Affi du membre au moment du clic d'offre (paramètre `tg`, phase 13).
  linkaffiTelegramCampaignKey String?
  /// Phase 17 : conversation de l'assistant dont le lien d'offre a été ouvert (première ouverture humaine).
  conversationId              String?
  conversation                Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt                   DateTime      @default(now())

  players        Player[]
  assistantOffer AssistantOfferLink?

  @@index([linkaffiTelegramCampaignKey])
  @@index([conversationId])
  @@index([memberId, createdAt])
  @@index([trackingLinkId, createdAt])
  @@index([postId, createdAt])
  @@index([ipHash, userAgent, trackingLinkId, createdAt])
  @@index([isBot, createdAt])
}

// ============================================================
// Phase 1 : messages programmés
// ============================================================

/// Catégorie de message (Bonus, Preuve de gains, Teasing…).
model MessageCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  color     String    @default("#64748b")
  vertical  Vertical?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  posts Post[]
}

/// Média réutilisable (photo, vidéo, gif, document) stocké en base (≤ 50 Mo).
model MediaAsset {
  id               String            @id @default(cuid())
  filename         String
  mimeType         String
  size             Int
  sha256           String            @unique
  bytes            Bytes
  width            Int?
  height           Int?
  duration         Int?
  createdById      String?
  createdBy        User?             @relation(fields: [createdById], references: [id])
  createdAt        DateTime          @default(now())
  /// Médiathèque des agents (phase 19) : équipe, thème, persona, nature, origine, mots-clés du dépôt.
  teamKey          String?
  theme            String?
  personaId        String?
  kind             MediaAssetKind?
  origin           MediaAssetOrigin?
  tags             Json              @default("[]")
  /// Copie dans le canal Telegram privé « Médiathèque » (facultative).
  libraryMessageId Int?
  /// Média produit par un fournisseur (phase 20) : vidéo source d'origine, travail chez le fournisseur, résolution.
  sourceAssetId    String?
  providerJobId    String?
  providerName     String?
  resolution       String?

  telegramFiles    MediaAssetTelegramFile[]
  usages           MediaUsage[]
  sequenceSteps    SequenceStep[]
  broadcasts       Broadcast[]
  outboundMessages OutboundMessage[]
  personas         Persona[]
  /// Phase 28 : où vivent les octets. "db" (défaut, colonne `bytes`) ou "telegram" (vidéo longue et shorts : `bytes`
  /// vide, fichier gardé dans Telegram ; `telegramRef` = { chatId, messageId, botId?, fileId?, fileUniqueId?, via }).
  storage          String                   @default("db")
  telegramRef      Json?
  montageSources   MontageJob[]             @relation("MontageSource")
  shortClips       ShortClip[]

  @@index([teamKey, theme])
  @@index([personaId, kind])
}

/// Identifiant Telegram d'un média une fois envoyé par un bot (réutilisable sans ré-upload).
model MediaAssetTelegramFile {
  id             String     @id @default(cuid())
  assetId        String
  asset          MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  botId          String
  bot            Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  telegramFileId String
  fileUniqueId   String
  createdAt      DateTime   @default(now())

  @@unique([assetId, botId])
}

/// Emoji animé (emoji personnalisé d'un pack Premium Telegram) de la bibliothèque de l'équipe (phase 12). Inséré dans
/// un texte HTML Telegram sous la forme `<tg-emoji emoji-id="<customEmojiId>"><fallback></tg-emoji>`.
model CustomEmoji {
  id            String            @id @default(cuid())
  /// Identifiant Telegram de l'emoji (`custom_emoji_id`, entier 64 bits en chaîne).
  customEmojiId String            @unique
  /// Emoji standard affiché quand l'animation n'est pas disponible (et compté dans la longueur du texte).
  fallback      String
  /// Pack (nom court Telegram, t.me/addemoji/<setName>) et son titre, s'ils sont connus.
  setName       String?
  setTitle      String?
  /// Format du fichier Telegram : "tgs" (Lottie compressé), "webm" (vidéo) ou "webp" (image) ; null tant qu'inconnu.
  format        String?
  /// Aperçu (fichier Telegram téléchargé, quelques Ko) et son type MIME ; null tant que le worker ne l'a pas récupéré.
  previewBytes  Bytes?
  previewMime   String?
  /// Dernière tentative de récupération de l'aperçu et son erreur éventuelle.
  previewAt     DateTime?
  previewError  String?
  source        CustomEmojiSource
  addedById     String?
  addedBy       User?             @relation(fields: [addedById], references: [id], onDelete: SetNull)
  /// Utilisation par l'équipe (emojis récents du sélecteur).
  useCount      Int               @default(0)
  lastUsedAt    DateTime?
  /// Retiré de la bibliothèque (les messages qui l'utilisent gardent leur balise).
  hiddenAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([setName])
  @@index([lastUsedAt])
  @@index([hiddenAt])
}

/// Message programmé pour un canal. `code` court pour les liens profonds d'offre.
model Post {
  id                  String           @id @default(cuid())
  code                String           @unique
  channelId           String
  channel             Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  botId               String
  bot                 Bot              @relation(fields: [botId], references: [id])
  status              PostStatus       @default(DRAFT)
  scheduledAt         DateTime?
  sentAt              DateTime?
  /// Identifiants Telegram des messages envoyés (JSON : number[] ; plusieurs pour un album).
  telegramMessageIds  Json             @default("[]")
  categoryId          String?
  category            MessageCategory? @relation(fields: [categoryId], references: [id])
  language            String           @default("fr")
  /// Texte en HTML Telegram (b, i, u, s, a, code, pre, tg-spoiler, blockquote).
  text                String           @default("")
  /// Médias dans l'ordre (JSON : string[] d'identifiants MediaAsset).
  mediaAssetIds       Json             @default("[]")
  /// Lignes de boutons (JSON, voir docs/DATA-MODEL.md).
  buttons             Json             @default("[]")
  pinAfterSend        Boolean          @default(false)
  unpinPrevious       Boolean          @default(false)
  deleteAfterMinutes  Int?
  disableNotification Boolean          @default(false)
  protectContent      Boolean          @default(false)
  disableLinkPreview  Boolean          @default(true)
  isTemplate          Boolean          @default(false)
  templateName        String?
  /// Univers du modèle (classement de la bibliothèque de modèles ; renseigné aussi sur les messages créés depuis un canal typé).
  vertical            Vertical?
  /// Test A/B : identifiant commun aux deux variantes d'un même test et lettre de la variante (A ou B).
  abGroupId           String?
  abVariant           String?
  lastError           String?
  attempts            Int              @default(0)
  createdById         String?
  createdBy           User?            @relation("PostCreatedBy", fields: [createdById], references: [id])
  updatedById         String?
  updatedBy           User?            @relation("PostUpdatedBy", fields: [updatedById], references: [id])
  duplicatedFromId    String?
  duplicatedFrom      Post?            @relation("PostDuplicates", fields: [duplicatedFromId], references: [id])
  duplicates          Post[]           @relation("PostDuplicates")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  stats            PostStats?
  trackingLinks    TrackingLink[]
  clicks           Click[]
  outboundMessages OutboundMessage[]
  viewSamples      PostViewSample[]
  /// Prochain relevé des vues par le compte Telegram connecté (phase 7) ; null = plus de relevé.
  viewsNextAt      DateTime?
  /// Qui publie ce message (phase 12) : BOT (défaut) ou ACCOUNT (compte Telegram connecté, message avec emojis animés,
  /// sans boutons). Un message publié par le compte n'est JAMAIS modifié ensuite par le bot (les emojis animés
  /// disparaîtraient) : épingler, désépingler et supprimer passent aussi par le compte.
  publisher        PostPublisher     @default(BOT)
  insight          PostInsight?
  /// Mission d'agent qui a produit ce message (phase 19).
  agentMissionId   String?
  agentMission     AgentMission?     @relation(fields: [agentMissionId], references: [id], onDelete: SetNull)

  @@index([channelId, scheduledAt])
  @@index([agentMissionId])
  @@index([status, scheduledAt])
  @@index([isTemplate, scheduledAt])
  @@index([categoryId])
  @@index([abGroupId])
  @@index([isTemplate, vertical])
}

/// Statistiques dénormalisées d'un message.
model PostStats {
  postId         String   @id
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  views          Int      @default(0)
  forwards       Int      @default(0)
  reactions      Json     @default("{}")
  reactionsTotal Int      @default(0)
  clicks         Int      @default(0)
  uniqueClickers Int      @default(0)
  offerClicks    Int      @default(0)
  registrations  Int      @default(0)
  ftds           Int      @default(0)
  deposits       Int      @default(0)
  depositAmount  Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt      DateTime @updatedAt
}

// ============================================================
// Phase 1 : séquences de messages privés
// ============================================================

/// Séquence de messages privés déclenchée par un événement, par canal et/ou par bot.
model Sequence {
  id        String          @id @default(cuid())
  name      String
  botId     String?
  bot       Bot?            @relation(fields: [botId], references: [id])
  channelId String?
  channel   Channel?        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  trigger   SequenceTrigger
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  steps SequenceStep[]

  /// Une seule séquence par canal et par déclencheur (phase 8 : plusieurs bots créaient les séquences par défaut en même temps).
  /// PostgreSQL traite les NULL comme distincts : les séquences globales (channelId vide) ne sont pas concernées,
  /// ce qui équivaut à un index unique partiel « WHERE channelId IS NOT NULL ».
  @@unique([channelId, trigger])
}

/// Étape d'une séquence : textes par langue, boutons, média, délai.
model SequenceStep {
  id           String      @id @default(cuid())
  sequenceId   String
  sequence     Sequence    @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order        Int         @default(0)
  delaySeconds Int         @default(0)
  /// Textes par langue (JSON : { fr: "...", en: "..." }), HTML Telegram, placeholders {prenom} {canal} {liste_canaux} {delai} {bot}.
  texts        Json        @default("{}")
  buttons      Json        @default("[]")
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])

  outboundMessages OutboundMessage[]

  @@index([sequenceId, order])
}

/// Message privé sortant (file d'attente et historique).
model OutboundMessage {
  id                String          @id @default(cuid())
  botId             String
  bot               Bot             @relation(fields: [botId], references: [id])
  memberId          String
  member            Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind              OutboundKind
  sequenceStepId    String?
  sequenceStep      SequenceStep?   @relation(fields: [sequenceStepId], references: [id])
  postId            String?
  post              Post?           @relation(fields: [postId], references: [id])
  broadcastId       String?
  broadcast         Broadcast?      @relation(fields: [broadcastId], references: [id])
  /// Relance automatique à l'origine du message (kind AUTOMATION), pour compter les « envoyés » par relance (phase 10).
  /// Relance supprimée : le message reste, le rattachement est effacé.
  automationRuleId  String?
  automationRule    AutomationRule? @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)
  /// Média joint (photo, vidéo, gif, document) envoyé avec le texte en légende.
  mediaAssetId      String?
  mediaAsset        MediaAsset?     @relation(fields: [mediaAssetId], references: [id])
  /// Identifiant du chat privé si différent du telegramUserId (user_chat_id).
  chatId            BigInt?
  text              String
  buttons           Json            @default("[]")
  status            OutboundStatus  @default(QUEUED)
  telegramMessageId Int?
  error             String?
  queuedAt          DateTime        @default(now())
  sentAt            DateTime?

  /// Phase 17 : message de conversation correspondant (kind ASSISTANT).
  conversationMessage ConversationMessage?

  @@index([memberId, queuedAt])
  @@index([status, queuedAt])
  @@index([broadcastId, status])
  @@index([memberId, status, sentAt])
  @@index([automationRuleId, status])
}

// ============================================================
// Phase 1 : affiliation (Link Affi) et joueurs
// ============================================================

/// Programme d'affiliation (casino, bookmaker…), importé de Link Affi (`casinos`) ou saisi.
model AffiliateProgram {
  id         String          @id @default(cuid())
  name       String
  vertical   Vertical?
  source     AffiliateSource @default(LINKAFFI)
  externalId String?
  isActive   Boolean         @default(true)
  raw        Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  campaigns         AffiliateCampaign[]
  postbackEndpoints PostbackEndpoint[]
  dailyStats        AffiliateDailyStat[]

  @@unique([source, externalId])
}

/// Campagne / lien de suivi Link Affi (`campaigns`), avec le modèle d'URL portant le sub-ID.
model AffiliateCampaign {
  id                  String           @id @default(cuid())
  programId           String
  program             AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  externalId          String
  /// Clé de campagne Link Affi (8 caractères, ex. 47eb8mwc).
  campaignKey         String?
  name                String
  vertical            Vertical?
  /// URL avec placeholder du sub-ID, ex. https://linkaffi.me/go/47eb8mwc?sub_id={subid}
  trackingUrlTemplate String
  isActive            Boolean          @default(true)
  raw                 Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  players       Player[]
  trackingLinks TrackingLink[]
  dailyStats    AffiliateDailyStat[]
  personas      Persona[]

  @@unique([programId, externalId])
  @@index([campaignKey])
}

/// Joueur chez un programme, rattaché à un membre par sub-ID quand possible.
model Player {
  id                  String            @id @default(cuid())
  affiliateCampaignId String
  affiliateCampaign   AffiliateCampaign @relation(fields: [affiliateCampaignId], references: [id], onDelete: Cascade)
  externalPlayerId    String
  subId               String?
  /// Origine du sub-ID côté Link Affi : `postback` (sûr) ou `time_match` (secours), null sinon.
  subIdSource         String?
  clickId             String?
  click               Click?            @relation(fields: [clickId], references: [id])
  memberId            String?
  member              Member?           @relation(fields: [memberId], references: [id])
  registeredAt        DateTime?
  ftdAt               DateTime?
  ftdAmount           Decimal?          @db.Decimal(14, 2)
  depositCount        Int               @default(0)
  redepositCount      Int               @default(0)
  depositTotal        Decimal           @default(0) @db.Decimal(14, 2)
  ngr                 Decimal           @default(0) @db.Decimal(14, 2)
  currency            String            @default("EUR")
  status              String?
  /// Phase 10 : statut de la commission CPA chez Link Affi (`players.cpa_status` : none | approved | not_eligible |
  /// reversed), null tant que la synchro ne l'a pas lu.
  cpaStatus           String?
  /// Commission CPA côté affilié en EUR (`players.cpa_affiliate_amount`) ; null = aucune ou inconnue. Reste renseignée
  /// après une annulation (c'est le montant annulé).
  cpaAmount           Decimal?          @db.Decimal(14, 2)
  /// Crédit de la CPA (`players.cpa_credited_at`). Peut manquer pour d'anciens joueurs approuvés : repli sur
  /// `qualified_at` (dans `raw`).
  cpaCreditedAt       DateTime?
  /// Annulation de la CPA (`players.cpa_reversed_at`).
  cpaReversedAt       DateTime?
  lastEventAt         DateTime?
  raw                 Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  events PlayerEvent[]

  @@unique([affiliateCampaignId, externalPlayerId])
  @@index([subId])
  @@index([memberId])
  @@index([clickId])
  @@index([registeredAt])
  @@index([ftdAt])
  @@index([lastEventAt])
  @@index([createdAt])
  @@index([cpaCreditedAt])
  @@index([cpaReversedAt])
}

/// Événement joueur brut (inscription, FTD, dépôt, redépôt, NGR…).
model PlayerEvent {
  id         String          @id @default(cuid())
  playerId   String
  player     Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type       PlayerEventType
  amount     Decimal?        @db.Decimal(14, 2)
  currency   String?
  occurredAt DateTime
  /// Identifiant externe (unique par programme quand il existe).
  externalId String?
  raw        Json?
  createdAt  DateTime        @default(now())

  @@unique([playerId, externalId])
  @@index([playerId, occurredAt])
  @@index([type, occurredAt])
}

/// Curseur de synchronisation d'une source (une ligne par table Link Affi).
model SyncState {
  source        String    @id
  cursor        Json      @default("{}")
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  rowsImported  Int       @default(0)
  isRunning     Boolean   @default(false)
  updatedAt     DateTime  @updatedAt
}

/// Agrégat journalier Link Affi (table `stats`), phase 10 : source de la part de revshare, qui n'existe qu'en agrégat.
/// UNE LIGNE PAR LIGNE LINK AFFI (clé `externalId` = `stats.id`), pas une par (jour, offre) : Link Affi ajoute des lignes
/// de correction (CPA annulée, revshare repris, prime) datées du jour d'origine mais créées plus tard (`sourceCreatedAt`),
/// et certaines lignes n'ont pas d'offre (`campaign_id` vide). Lire en additionnant par (date, affiliateCampaignId).
/// La table `stats` couvre tous les affiliés de Link Affi : seules nos offres comptent (règle « nos joueurs »).
model AffiliateDailyStat {
  id                  String             @id @default(cuid())
  /// `stats.id` : clé d'upsert (synchro idempotente).
  externalId          String             @unique
  /// Jour de l'agrégat (`stats.date`, jour de Paris côté Link Affi).
  date                DateTime           @db.Date
  /// Offre Link Affi (`stats.campaign_id` → AffiliateCampaign.externalId) ; vide si la ligne n'a pas d'offre ou si
  /// l'offre n'est pas encore synchronisée.
  affiliateCampaignId String?
  affiliateCampaign   AffiliateCampaign? @relation(fields: [affiliateCampaignId], references: [id], onDelete: SetNull)
  /// `stats.campaign_id` brut, gardé même quand l'offre est inconnue chez nous (rattachement ultérieur).
  campaignExternalId  String?
  /// Programme (casino) : `stats.casino_id` → AffiliateProgram.externalId.
  programId           String?
  program             AffiliateProgram?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  programExternalId   String?
  /// `stats.affiliate_id` (affilié Link Affi).
  affiliateExternalId String?
  /// Volumes Link Affi (contrôle de cohérence avec nos propres chiffres ; `deposits` peut être négatif sur une correction).
  clicks              Int                @default(0)
  signups             Int                @default(0)
  deposits            Int                @default(0)
  depositAmount       Decimal            @default(0) @db.Decimal(14, 2)
  /// Commission totale de l'affilié (`stats.revenue`, arrondie au centime par Link Affi). Contient parfois des primes ou
  /// corrections manuelles absentes de `cpaRevenue` et `revshareRevenue`.
  revenue             Decimal            @default(0) @db.Decimal(14, 4)
  /// Part CPA de l'affilié (`stats.cpa_revenue`).
  cpaRevenue          Decimal            @default(0) @db.Decimal(14, 4)
  /// Part de revshare de l'affilié (`stats.revshare_revenue`, souvent fractionnaire, parfois négative).
  revshareRevenue     Decimal            @default(0) @db.Decimal(14, 4)
  /// Création de la ligne chez Link Affi (`stats.created_at`) : une correction est créée après le jour qu'elle corrige.
  sourceCreatedAt     DateTime?
  /// Ligne Link Affi complète (recalcul sans resynchroniser).
  raw                 Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([date])
  @@index([affiliateCampaignId, date])
  @@index([programId, date])
}

// ============================================================
// Phase 1 : pubs
// ============================================================

/// Pub (TikTok, Meta, autre) : regroupe liens d'entrée, canaux et campagnes d'affiliation.
model Campaign {
  id                   String               @id @default(cuid())
  name                 String
  vertical             Vertical?
  channelIds           Json                 @default("[]")
  affiliateCampaignIds Json                 @default("[]")
  adPlatform           AdPlatform?
  adExternalIds        Json?
  externalCampaignId   String?
  /// Compte publicitaire connecté par API qui alimente cette campagne (phase 7).
  connectionId         String?
  connection           AdAccountConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  budgetDaily          Decimal?             @db.Decimal(14, 2)
  currency             String               @default("EUR")
  tags                 Json                 @default("[]")
  startAt              DateTime?
  endAt                DateTime?
  status               CampaignStatus       @default(DRAFT)
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  inviteLinks   InviteLink[]
  trackingLinks TrackingLink[]
  adSets        AdSet[]
  costs         AdCost[]
  dailyStats    DailyStat[]
  personas      Persona[]
}

/// Groupe de pubs (adset / ad group) d'une campagne.
model AdSet {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ads   Ad[]
  costs AdCost[]

  @@unique([campaignId, name])
}

/// Pub précise (une pub = un lien d'entrée).
model Ad {
  id             String        @id @default(cuid())
  adSetId        String
  adSet          AdSet         @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  name           String
  externalId     String?
  inviteLinkId   String?       @unique
  inviteLink     InviteLink?   @relation("AdInviteLink", fields: [inviteLinkId], references: [id])
  trackingLinkId String?       @unique
  trackingLink   TrackingLink? @relation(fields: [trackingLinkId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  costs          AdCost[]
  dailyStats     DailyStat[]
  landingSources LandingSource[]
  /// Liens des pages d'atterrissage créés pour cette pub (`InviteLink.landingAdId`, figée à la création).
  landingLinks   InviteLink[]    @relation("LandingAdLinks")

  @@unique([adSetId, name])
}

/// Coût publicitaire par jour, à un niveau (pub, groupe ou campagne) et pour une source.
model AdCost {
  id            String       @id @default(cuid())
  campaignId    String?
  campaign      Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSetId       String?
  adSet         AdSet?       @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  adId          String?
  ad            Ad?          @relation(fields: [adId], references: [id], onDelete: Cascade)
  /// Niveau concaténé pour l'unicité : "ad:<id>" | "adset:<id>" | "campaign:<id>".
  levelKey      String
  date          DateTime     @db.Date
  /// Dépense convertie en EUR (toutes les statistiques lisent cette colonne).
  spend         Decimal      @default(0) @db.Decimal(14, 2)
  /// Dépense dans la devise du compte (phase 7, API) ; null = saisie ou importée en EUR.
  spendOriginal Decimal?     @db.Decimal(14, 2)
  impressions   Int          @default(0)
  clicks        Int          @default(0)
  currency      String       @default("EUR")
  source        CostSource   @default(MANUAL)
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([levelKey, date, source])
  @@index([date])
}

/// Import de fichier (coûts, joueurs).
model ImportBatch {
  id          String     @id @default(cuid())
  kind        ImportKind
  filename    String
  rows        Int        @default(0)
  imported    Int        @default(0)
  errors      Json       @default("[]")
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  costs AdCost[]
}

/// Point d'entrée des postbacks directs d'un programme.
model PostbackEndpoint {
  id             String           @id @default(cuid())
  programId      String
  program        AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  name           String
  token          String           @unique
  /// Correspondance des paramètres reçus : { sub_id: "subid", player_id: "pid", event: "event", amount: "amount", currency: "currency", eventMap: { reg: "REGISTRATION", ... } }.
  mapping        Json             @default("{}")
  isActive       Boolean          @default(true)
  lastReceivedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  logs PostbackLog[]
}

/// Journal des postbacks reçus (append-only).
model PostbackLog {
  id            String           @id @default(cuid())
  endpointId    String
  endpoint      PostbackEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  receivedAt    DateTime         @default(now())
  ipHash        String?
  raw           Json             @default("{}")
  status        PostbackStatus   @default(ACCEPTED)
  message       String?
  playerEventId String?

  @@index([endpointId, receivedAt])
}

/// Envoi groupé ciblé (segment de membres).
model Broadcast {
  id           String          @id @default(cuid())
  name         String
  botId        String
  bot          Bot             @relation(fields: [botId], references: [id])
  /// Filtres du segment (JSON) : channelIds, spendLevels, inviteLinkIds, campaignIds, languages, inactiveDays, clickedCategoryIds…
  segment      Json            @default("{}")
  text         String
  buttons      Json            @default("[]")
  mediaAssetId String?
  mediaAsset   MediaAsset?     @relation(fields: [mediaAssetId], references: [id])
  status       BroadcastStatus @default(DRAFT)
  scheduledAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  targeted     Int             @default(0)
  sent         Int             @default(0)
  failed       Int             @default(0)
  blocked      Int             @default(0)
  lastError    String?
  /// Test A/B : identifiant commun aux variantes d'un même test et part (en %) des destinataires pour cette variante.
  abGroupId    String?
  abVariant    String?
  abSplit      Int?
  createdById  String?
  createdBy    User?           @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  outboundMessages OutboundMessage[]

  @@index([status, scheduledAt])
  @@index([abGroupId])
  @@index([createdAt])
}

/// Règle d'automatisation « si… alors… ».
model AutomationRule {
  id            String            @id @default(cuid())
  name          String
  trigger       AutomationTrigger
  /// Conditions (JSON) : channelIds, campaignIds, languages, spendLevels, inactiveDays, categoryIds…
  conditions    Json              @default("{}")
  /// Actions ordonnées (JSON) : [{ type: "send_message", text, buttons?, mediaAssetId?, botId? } | { type: "send_sequence", trigger } | { type: "wait", hours } | { type: "tag", tag } | { type: "suggest_channel", channelId } | { type: "notify_team", text }].
  actions       Json              @default("[]")
  /// Parcours à branches (JSON, `AutomationGraph` de packages/core/src/automation-graph.ts : { version: 1, nodes, edges }).
  /// Vide = règle linéaire (`actions`, exécutée comme avant) ; renseigné, il prime sur `actions`.
  graph         Json?
  /// Carte « prête à l'emploi » que la règle implémente (welcome, offer_no_signup, signup_no_deposit, inactive_7d,
  /// first_deposit_thanks, vip) ; vide = relance sur mesure.
  templateKey   String?
  isActive      Boolean           @default(false)
  /// Une seule exécution par membre et par règle (sauf si false).
  oncePerMember Boolean           @default(true)
  runs          Int               @default(0)
  lastRunAt     DateTime?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  executions       AutomationRun[]
  trackingLinks    TrackingLink[]
  outboundMessages OutboundMessage[]

  @@index([trigger, isActive])
}

/// Exécution d'une règle pour un membre (journal + file des étapes différées).
model AutomationRun {
  id        String              @id @default(cuid())
  ruleId    String
  rule      AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    AutomationRunStatus @default(PENDING)
  /// Règle linéaire : index de la prochaine action à exécuter. Graphe : nombre de blocs déjà parcourus.
  step      Int                 @default(0)
  /// Graphe : bloc courant (prochain bloc après une attente, bloc en erreur, dernier bloc parcouru une fois terminée).
  /// Vide pour une règle linéaire.
  nodeId    String?
  /// Reprise des étapes « attendre ».
  resumeAt  DateTime?
  context   Json                @default("{}")
  log       Json                @default("[]")
  error     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([ruleId, memberId, createdAt])
  @@index([status, resumeAt])
  @@index([memberId])
}

/// Alerte système (bot en erreur, synchro en échec, file engorgée…).
model Alert {
  id         String        @id @default(cuid())
  kind       String
  severity   AlertSeverity @default(WARNING)
  message    String
  payload    Json          @default("{}")
  createdAt  DateTime      @default(now())
  notifiedAt DateTime?
  resolvedAt DateTime?

  @@index([kind, createdAt])
  @@index([resolvedAt])
}

/// Statistiques journalières pré-calculées (par canal, pub, campagne ou univers ; une ligne par combinaison).
model DailyStat {
  id                  String    @id @default(cuid())
  date                DateTime  @db.Date
  /// Clé de dimension : "all" | "channel:<id>" | "campaign:<id>" | "ad:<id>" | "vertical:<V>".
  dimension           String
  channelId           String?
  channel             Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  campaignId          String?
  campaign            Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adId                String?
  ad                  Ad?       @relation(fields: [adId], references: [id], onDelete: Cascade)
  vertical            Vertical?
  requests            Int       @default(0)
  approved            Int       @default(0)
  joined              Int       @default(0)
  left                Int       @default(0)
  entryClicks         Int       @default(0)
  offerClicks         Int       @default(0)
  registrations       Int       @default(0)
  ftds                Int       @default(0)
  deposits            Int       @default(0)
  depositAmount       Decimal   @default(0) @db.Decimal(14, 2)
  ngr                 Decimal   @default(0) @db.Decimal(14, 2)
  spend               Decimal   @default(0) @db.Decimal(14, 2)
  /// Phase 10 : nos commissions du jour en EUR (CPA nette + part de revshare). Gains = commissions − spend ; jamais
  /// les dépôts ni le revenu net (argent du casino).
  commissions         Decimal   @default(0) @db.Decimal(14, 2)
  /// Détail : CPA créditées − CPA annulées, chacune au jour réel (événements CPA / CPA_REVERSAL).
  cpaCommissions      Decimal   @default(0) @db.Decimal(14, 2)
  /// Détail : part de revshare (agrégat Link Affi `AffiliateDailyStat` de nos offres).
  revshareCommissions Decimal   @default(0) @db.Decimal(14, 2)
  updatedAt           DateTime  @updatedAt

  @@unique([date, dimension])
  @@index([dimension, date])
}

/// Note interne sur un membre.
model MemberNote {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

// ============================================================
// Phase 7 : connecteurs directs (Meta, TikTok) et vues Telegram
// ============================================================

/// Identifiants d'application développeur par plateforme (une ligne par plateforme ; secret chiffré AES-256-GCM).
model ConnectorApp {
  platform        AdPlatform @id
  clientId        String
  secretEncrypted String
  /// Options par plateforme (JSON) : Meta `configId`, TikTok `sandbox`, Telegram `apiId`…
  extra           Json       @default("{}")
  verifiedAt      DateTime?
  lastError       String?
  updatedById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

/// Compte publicitaire connecté par OAuth (plusieurs par plateforme, par utilisateur).
model AdAccountConnection {
  id                    String           @id @default(cuid())
  platform              AdPlatform
  /// Identifiant chez la plateforme : Meta `act_<id>`, TikTok `advertiser_id`.
  externalId            String
  name                  String
  currency              String           @default("EUR")
  timezone              String?
  businessName          String?
  status                ConnectionStatus @default(ACTIVE)
  tokenEncrypted        String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scopes                String?
  connectedById         String?
  connectedBy           User?            @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  lastSyncAt            DateTime?
  lastSyncRows          Int              @default(0)
  lastError             String?
  /// Prochaine resynchronisation longue (28 jours), une fois par nuit.
  nextFullSyncAt        DateTime?
  /// Historique initial (90 jours) déjà chargé.
  backfilledAt          DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  campaigns Campaign[]
  runs      ConnectorSyncRun[]

  @@unique([platform, externalId])
  @@index([status])
}

/// Journal d'une synchronisation de dépenses (visible dans Réglages → Connecteurs).
model ConnectorSyncRun {
  id           String              @id @default(cuid())
  connectionId String
  connection   AdAccountConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?
  dateFrom     DateTime            @db.Date
  dateTo       DateTime            @db.Date
  rows         Int                 @default(0)
  /// running | ok | error
  status       String              @default("running")
  error        String?

  @@index([connectionId, startedAt])
}

/// Session utilisateur Telegram (MTProto) pour lire les vues des messages : une seule ligne (`main`).
model TelegramUserSession {
  id               String    @id @default("main")
  phone            String
  /// Session GramJS (StringSession) chiffrée.
  sessionEncrypted String
  /// PENDING_CODE | PENDING_PASSWORD | ACTIVE | ERROR | DISCONNECTED
  status           String    @default("PENDING_CODE")
  phoneCodeHash    String?
  connectedById    String?
  lastUsedAt       DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Relevé des vues et transferts d'un message de canal (pour les courbes).
model PostViewSample {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  at       DateTime @default(now())
  views    Int      @default(0)
  forwards Int      @default(0)

  @@index([postId, at])
}

// ============================================================
// Phase 8 : assistant IA d'écriture des messages
// ============================================================

/// Suggestion produite par l'assistant IA d'écriture (phase 8) : brouillon d'entrée, 3 versions proposées, jetons et coût estimé.
/// `kind` : improve | idea | shorter | punchier | angle | translate | ab_variant. `context` : univers, catégorie, langue,
/// objectif, ton, longueur, média, surface (post | bot_text | broadcast | template | automation). `usedIndex` : version retenue.
model AiSuggestion {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  kind         String
  context      Json     @default("{}")
  input        String
  /// Versions proposées (JSON : `{ text, why }[]`, ou pour `translate` une entrée par langue).
  outputs      Json     @default("[]")
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  costEur      Decimal  @default(0) @db.Decimal(10, 4)
  usedIndex    Int?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ============================================================
// Phase 13 : campagnes Telegram des affiliés Link Affi (docs/LINKAFFI-PARTENAIRES.md)
// ============================================================

/// État d'un événement à envoyer à Link Affi (fonction `telegram-events`).
enum LinkaffiEventStatus {
  /// À envoyer (ou nouvel essai prévu à `nextAttemptAt`).
  PENDING
  /// Reçu par Link Affi (réponse 2xx).
  SENT
  /// Abandonné après 24 h de tentatives (Link Affi peut le rattraper par `GET /members`).
  FAILED
}

/// Événement d'un membre d'affilié à envoyer à Link Affi : `join_requested`, `join_approved`, `join_declined`,
/// `join_expired`, `joined`, `left`, `offer_clicked`. Corps exact du contrat dans `body` (JSON), signé HMAC-SHA256 à
/// l'envoi avec le secret de `IntegrationKey`. `eventId` unique et déterministe : un doublon n'est jamais créé ni
/// envoyé deux fois ; Link Affi ignore de toute façon un `eventId` déjà reçu.
model LinkaffiEvent {
  id            String              @id @default(cuid())
  eventId       String              @unique
  type          String
  occurredAt    DateTime
  campaignKey   String
  memberId      String?
  channelId     String?
  /// Corps envoyé (contrat § 2), tel quel.
  body          Json
  status        LinkaffiEventStatus @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  lastError     String?
  lastStatus    Int?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([campaignKey, occurredAt])
  @@index([memberId])
}

/// Clés de l'intégration Link Affi (une ligne, `provider` = "linkaffi") : clé d'API que Link Affi envoie à notre API
/// d'intégration (stockée hachée SHA-256, affichée une seule fois à la génération) et secret de signature des
/// événements (chiffré AES-256-GCM avec APP_ENCRYPTION_KEY), adresse de la fonction `telegram-events`.
model IntegrationKey {
  provider               String    @id
  apiKeyHash             String?   @unique
  /// Début de la clé (affiché pour la reconnaître, jamais la clé entière).
  apiKeyPrefix           String?
  apiKeyCreatedAt        DateTime?
  apiKeyCreatedById      String?
  webhookSecretEncrypted String?
  webhookSecretCreatedAt DateTime?
  /// Adresse de la fonction Link Affi qui reçoit les événements (modifiable).
  eventsUrl              String?
  lastApiCallAt          DateTime?
  lastEventSentAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// ─── Phase 15 : pages d'atterrissage Telegram (rubrique « Pages ») ───────────────────────────────────────────────

/// Page d'atterrissage d'un canal, servie sur le domaine de tracking (`https://go.goolink.eu/j/<slug>?src=<source>`) :
/// un écran, le vrai titre du canal (jamais saisi), une accroche, un bouton « Rejoindre le canal → ». HTML pré-rendu
/// gardé en mémoire par le service web, invalidé par Redis à chaque modification (`version`) ou changement de titre.
model LandingPage {
  id            String   @id @default(cuid())
  /// Adresse publique (`/j/<slug>`), minuscules, chiffres et tirets.
  slug          String   @unique
  /// Nom interne de la page (rubrique Pages, nom des liens d'invitation « <page>-<source> »).
  name          String
  channelId     String
  channel       Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Langue de la page (fr par défaut ; mêmes langues que les textes du bot) : textes par défaut, `lang` du HTML.
  language      String   @default("fr")
  /// Phrase d'accroche (obligatoire).
  headline      String
  /// Sous-texte court, facultatif.
  subtext       String?
  /// Texte du bouton ; null = texte par défaut de la langue (« Rejoindre le canal → »).
  buttonText    String?
  /// Petite ligne sous le bouton, facultative (« Gratuit · 1 clic · via Telegram »).
  footnote      String?
  /// Photo du canal affichée (désactivée par défaut).
  showPhoto     Boolean  @default(false)
  /// Bandeau cookies (désactivé par défaut) : s'il est actif, les pixels ne se chargent qu'après accord.
  cookieBanner  Boolean  @default(false)
  /// Pixel TikTok et pixel Meta, facultatifs, vérifiés à la saisie.
  tiktokPixelId String?
  metaPixelId   String?
  isActive      Boolean  @default(true)
  /// Augmentée à chaque modification : clé du HTML en mémoire et de l'ETag.
  version       Int      @default(1)
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sources     LandingSource[]
  inviteLinks InviteLink[]
  events      LandingEvent[]

  @@index([channelId])
}

/// Source d'une page (« tk01 », « exo1 ») : son propre lien d'invitation (kind LANDING), lu par `?src=`. La clé ""
/// est la source par défaut (visite sans `?src=` ou avec une source inconnue), créée avec la page.
model LandingSource {
  id            String      @id @default(cuid())
  landingPageId String
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  /// Clé lue dans `?src=` (lettres, chiffres, tirets, soulignés ; 1 à 32 caractères) ; "" = source par défaut.
  key           String
  /// Lien d'invitation actuel de la source (null tant que Telegram ne l'a pas créé : `linkError` dit pourquoi).
  inviteLinkId  String?     @unique
  inviteLink    InviteLink? @relation("LandingSourceLink", fields: [inviteLinkId], references: [id], onDelete: SetNull)
  /// Dernier refus de Telegram à la création du lien (texte en français), null si le lien existe.
  linkError     String?
  /// Dernier essai de création du lien (réussi ou non) : la reprise du worker passe d'abord les pages essayées le moins
  /// récemment (chacune à son tour).
  linkTriedAt   DateTime?
  /// Pub d'une de nos campagnes reliée à la source (facultatif) : sa dépense donne le coût par join.
  adId          String?
  ad            Ad?         @relation(fields: [adId], references: [id], onDelete: SetNull)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([landingPageId, key])
  @@index([adId])
}

enum LandingEventType {
  /// Page affichée dans un vrai navigateur (envoi `sendBeacon` après l'affichage).
  VIEW
  /// Clic sur le bouton (avec la façon d'ouvrir Telegram, `method`).
  CLICK
  /// Page quittée dans les 2 secondes qui suivent le clic : Telegram s'est (très probablement) ouvert.
  OPENED
  /// Phase 16 : aide plein écran « Appuie sur ⋯ puis « Ouvrir dans le navigateur » » affichée dans un navigateur
  /// intégré (TikTok, Instagram…) après l'appui sur le bouton.
  HELP
  /// Phase 16 : la visite est sortie de l'appli : page rouverte dans Safari / Chrome avec le marqueur `tgo=1` (ou un
  /// `ttclid` / `fbclid` hors navigateur intégré), rattachée à la visite d'origine (`visitId` = `vid` de l'adresse).
  ESCAPED
  /// Phase 16 : ouverture automatique de Telegram tentée au chargement dans Safari / Chrome (avec `method`).
  AUTO_OPEN
}

/// Visite, clic et ouverture de Telegram sur une page d'atterrissage (append-only, enregistrés par la file
/// `landing-events`, jamais pendant la réponse). Adresse IP jamais conservée : empreinte `ipHash` et pays seulement.
/// Purgée avec les autres données personnelles (24 mois).
model LandingEvent {
  id            String           @id @default(cuid())
  landingPageId String
  landingPage   LandingPage      @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  /// Source retenue (clé de `LandingSource` ; "" = source par défaut).
  sourceKey     String           @default("")
  /// `?src=` tel que reçu quand il ne correspond à aucune source (diagnostic), sinon null.
  rawSrc        String?
  type          LandingEventType
  /// Identifiant aléatoire de la visite (créé par la page) : relie affichage, clic et ouverture.
  visitId       String
  /// Système : IOS | ANDROID | OTHER.
  os            String?
  /// Navigateur intégré reconnu : TIKTOK | INSTAGRAM | FACEBOOK | OTHER.
  inApp         String?
  /// Façon d'ouvrir Telegram (clic et ouverture) : par exemple TG_SCHEME | INTENT | HTTPS.
  method        String?
  /// Pays (ISO 3166-1 alpha-2) déduit de l'adresse IP par une base locale, adresse jamais gardée.
  country       String?
  ipHash        String?
  /// Robot connu (`isBotUserAgent`) : gardé mais jamais compté.
  isBot         Boolean          @default(false)
  ttclid        String?
  fbclid        String?
  userAgent     String?
  createdAt     DateTime         @default(now())

  @@index([landingPageId, createdAt])
  @@index([landingPageId, type, createdAt])
  @@index([visitId])
  @@index([createdAt])
}

// ─── Phase 17 : assistant de conversation (rencontres), contrat docs/ASSISTANT-CONVERSATION.md ─────────────────────

/// Mode d'un bot : bot normal ou assistant de conversation (réglé par un ADMIN dans Réglages → Bots).
enum BotMode {
  STANDARD
  ASSISTANT
}

/// Étape du parcours d'une conversation : ACCUEIL → DISCUSSION → PROPOSITION → LIEN ENVOYÉ → RELANCE → CONVERTI → FERMÉ.
enum ConversationStage {
  WELCOME
  CHAT
  PROPOSAL
  LINK_SENT
  FOLLOW_UP
  CONVERTED
  CLOSED
}

/// Qui répond : l'assistant (BOT), l'équipe (HUMAN, reprise en main), personne pour l'instant (PAUSED), conversation
/// fermée (CLOSED : /stop, mineur, équipe, blocage).
enum ConversationStatus {
  BOT
  HUMAN
  PAUSED
  CLOSED
}

/// Sens d'un message de conversation : reçu de la personne (IN) ou envoyé par le bot (OUT).
enum ConversationDirection {
  IN
  OUT
}

/// Auteur d'un message de conversation : la personne, l'assistant, un membre de l'équipe, ou un texte fixe du système.
enum ConversationAuthor {
  MEMBER
  ASSISTANT
  TEAM
  SYSTEM
}

/// Persona de l'assistant : prénom, personnalité et ton d'un assistant ASSUMÉ (jamais une vraie personne), règles du
/// parcours et offre liée. Le premier message et la description du bot disent « l'assistante » / « l'assistant ».
model Persona {
  id                      String             @id @default(cuid())
  /// Prénom affiché, ex. « Léa ».
  name                    String
  /// "F" → « l'assistante », "M" → « l'assistant ».
  gender                  String             @default("F")
  personality             String             @default("")
  tone                    String             @default("")
  /// Langues de réponse (codes de packages/telegram/src/i18n.ts : fr en es pt de it), la première par défaut.
  languages               String[]           @default(["fr"])
  interests               String[]           @default([])
  extraPrompt             String?
  /// Modèle Venice ; null = modèle par défaut des réglages.
  model                   String?
  /// Température ; null = réglage général (0,85).
  temperature             Float?
  /// Messages de la personne avant tout lien (jamais au premier message).
  minExchangesBeforeOffer Int                @default(4)
  /// Intérêt d'au moins 6/10 exigé avant le lien.
  requireInterest         Boolean            @default(true)
  /// Envois du lien par conversation (1 à 3).
  maxOfferSends           Int                @default(2)
  /// Première relance après X heures de silence (au moins 4) ; la seconde au moins 24 h après la première.
  followUpAfterHours      Int                @default(24)
  /// Relances après un silence (0 à 2, jamais plus de 2).
  followUpsMax            Int                @default(2)
  /// Offre Link Affi liée.
  affiliateCampaignId     String?
  affiliateCampaign       AffiliateCampaign? @relation(fields: [affiliateCampaignId], references: [id], onDelete: SetNull)
  /// Notre campagne : rattachement des statistiques.
  campaignId              String?
  campaign                Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  /// Fiche de l'offre : seuls éléments que l'assistant peut dire de l'offre (ni chiffres inventés, ni promesses).
  offerPitch              String             @default("")
  offerButtonText         String             @default("Découvrir l'app")
  /// Visuel de l'app ou de l'offre (jamais un « selfie »).
  offerMediaAssetId       String?
  offerMediaAsset         MediaAsset?        @relation(fields: [offerMediaAssetId], references: [id], onDelete: SetNull)
  /// Description du bot (≤ 512) et description courte (≤ 120) : disent « assistant(e) ».
  botDescription          String?
  botShortDescription     String?
  /// Identité présentée : "ASSISTANT" (assistante du canal, phase 17) ou "GIRL" (une fille, userbots phase 18).
  identityKind            String             @default("ASSISTANT")
  /// Âge déclaré (repris par le prompt en GIRL quand il est renseigné).
  age                     Int?
  /// Mode illusion (GIRL seulement) : se présente comme une vraie fille, ne dit jamais être une IA. Sans effet en ASSISTANT.
  illusion                Boolean            @default(false)
  /// Exemples de registre (échanges courts « lui: / moi: ») imités par le modèle, jamais recopiés.
  styleExamples           String?            @db.Text
  /// Médias du personnage (phase 20) : 1 à 3 images de référence (`MediaAsset`, la première sert au remplacement
  /// vidéo), fichier LoRA (adresse), mot déclencheur et poids, consignes de tenue / d'ambiance.
  referenceImageIds       Json               @default("[]")
  loraUrl                 String?
  loraTrigger             String?
  loraScale               Float              @default(0.8)
  mediaNotes              String?            @db.Text
  /// Phase 21 : heures de relance conseillées par l'équipe Algorithme (JSON number[], heure de Paris) ; lues par le
  /// moteur de relances seulement si une recommandation les a appliquées.
  suggestedFollowUpHours  Json?
  /// Phase 25 : univers de la persona (dating, casino, sports). Casino et Paris sportifs : identité assistante imposée.
  universe                String             @default("dating")
  /// Phase 25 : fiche d'informations (JSON `{ q, a }[]`, 40 entrées au plus) : seule source de ce que l'assistante
  /// peut affirmer (bonus, dépôt minimum, pays, délais de retrait, VIP) ; le reste est transmis à l'équipe.
  faq                     Json               @default("[]")
  isActive                Boolean            @default(false)
  createdById             String?
  createdBy               User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  bots          Bot[]
  conversations Conversation[]
  trackingLinks TrackingLink[]
  offerLinks    AssistantOfferLink[]
  usages        AiConversationUsage[]
  accounts      TelegramUserAccount[]
}

/// Conversation privée entre un bot ASSISTANT et une personne qui lui a écrit d'elle-même (une par bot et par membre).
/// Supprimée avec le membre ou le bot ; `/reset` efface les messages, le résumé, les faits et le style.
model Conversation {
  id               String             @id @default(cuid())
  botId            String
  bot              Bot                @relation(fields: [botId], references: [id], onDelete: Cascade)
  memberId         String
  member           Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// Persona du bot au premier message.
  personaId        String?
  persona          Persona?           @relation(fields: [personaId], references: [id], onDelete: SetNull)
  /// Paramètre du /start (nettoyé : [A-Za-z0-9_-]{1,64}), premier reçu, jamais écrasé.
  source           String?
  stage            ConversationStage  @default(WELCOME)
  status           ConversationStatus @default(BOT)
  /// Profil de style de la personne (longueur, emojis, registre, langue, ton, intérêt), fusionné à chaque tour.
  styleProfile     Json               @default("{}")
  /// Résumé roulant des messages anciens.
  summary          String?
  /// Faits dits par la personne elle-même (JSON : string[], 20 au plus).
  facts            Json               @default("[]")
  /// Langue de réponse courante.
  language         String?
  isMinor          Boolean            @default(false)
  /// /stop (définitif : plus aucune réponse ni relance).
  stoppedAt        DateTime?
  closedAt         DateTime?
  /// STOP | MINOR | TEAM | BLOCKED (bot bloqué) | UNREACHABLE.
  closedReason     String?
  takenOverById    String?
  takenOverBy      User?              @relation(fields: [takenOverById], references: [id], onDelete: SetNull)
  takenOverAt      DateTime?
  /// Phase 25 : conversation « à traiter » par l'équipe (question hors fiche, réclamation, argent, mineur, insulte).
  needsHumanAt     DateTime?
  needsHumanReason String?
  /// Messages de la personne (échanges).
  memberMessages   Int                @default(0)
  assistantTurns   Int                @default(0)
  offerSends       Int                @default(0)
  lastInboundAt    DateTime?
  lastAssistantAt  DateTime?
  followUpCount    Int                @default(0)
  nextFollowUpAt   DateTime?
  /// Nouvel essai après une panne de l'IA.
  retryAt          DateTime?
  convertedAt      DateTime?
  /// La personne a refuse l'app (refus de l'appli, « on reste sur Telegram ») : plus de discussion ici.
  appRefusedAt     DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  messages   ConversationMessage[]
  events     ConversationEvent[]
  offerLinks AssistantOfferLink[]
  clicks     Click[]
  usages     AiConversationUsage[]

  @@unique([botId, memberId])
  @@index([status, nextFollowUpAt])
  @@index([needsHumanAt])
  @@index([status, retryAt])
  @@index([personaId, createdAt])
  @@index([source])
  @@index([lastInboundAt])
  @@index([memberId])
}

/// Message d'une conversation (texte brut, jamais de HTML). Purgé avec les données personnelles et par /reset.
model ConversationMessage {
  id                String                @id @default(cuid())
  conversationId    String
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         ConversationDirection
  author            ConversationAuthor
  /// Membre de l'équipe auteur du message (author TEAM).
  teamUserId        String?
  teamUser          User?                 @relation(fields: [teamUserId], references: [id], onDelete: SetNull)
  /// Texte brut ; média sans légende : "".
  text              String
  /// { kind: "photo"|"sticker"|"voice"|"video"|"document"|"other", mediaAssetId? }.
  media             Json?
  /// { offerSubId?, model?, rejected?: string[], followUp?: true, neutral?: true, command? }.
  meta              Json                  @default("{}")
  telegramMessageId BigInt?
  /// Message privé sortant correspondant (OUT, kind ASSISTANT).
  outboundMessageId String?               @unique
  outboundMessage   OutboundMessage?      @relation(fields: [outboundMessageId], references: [id], onDelete: SetNull)
  /// IN : tour qui l'a traité ; OUT : tour qui l'a produit.
  turnId            String?
  /// OUT assistant : rang dans le tour (0 à 2).
  partIndex         Int?
  /// IN : heure de réclamation par un tour du worker en cours (null une fois le tour terminé ou le message rendu) ;
  /// sert au balayage des tours bloqués (index : jamais une lecture de toute la table).
  claimedAt         DateTime?
  createdAt         DateTime              @default(now())

  @@unique([conversationId, direction, telegramMessageId])
  @@unique([turnId, partIndex])
  @@index([conversationId, createdAt])
  @@index([conversationId, direction, turnId])
  @@index([claimedAt])
}

/// Événement d'une conversation (append-only, aucun texte) : statistiques du parcours, survit à /reset.
/// `type` : stage_changed | offer_sent | offer_opened | follow_up_sent | stopped | reset | minor | taken_over |
/// released | blocked | closed | ai_failed | cap_reached | daily_limit | converted.
model ConversationEvent {
  id             String             @id @default(cuid())
  conversationId String
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           String
  fromStage      ConversationStage?
  toStage        ConversationStage?
  payload        Json               @default("{}")
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
  @@index([type, createdAt])
}

/// Lien d'offre envoyé par l'assistant : un sub-ID unique par conversation et par envoi (`go.goolink.eu/a/<subId>`).
/// Le `Click` est créé à la première ouverture humaine.
model AssistantOfferLink {
  id             String        @id @default(cuid())
  /// newSubId() de core (12 caractères base62).
  subId          String        @unique
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  personaId      String?
  persona        Persona?      @relation(fields: [personaId], references: [id], onDelete: SetNull)
  botId          String
  bot            Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  memberId       String?
  member         Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// Lien OFFER de la persona.
  trackingLinkId String
  trackingLink   TrackingLink  @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  /// Copie de `Conversation.source` (statistiques après suppression de la conversation).
  source         String?
  sentAt         DateTime      @default(now())
  firstOpenedAt  DateTime?
  opens          Int           @default(0)
  clickId        String?       @unique
  click          Click?        @relation(fields: [clickId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([personaId, sentAt])
}

/// Coût d'un appel à l'IA de conversation (Venice), sur le modèle d'`AiSuggestion`. Le plafond mensuel est la somme de
/// `costEur` depuis le début du mois à Paris.
model AiConversationUsage {
  id             String        @id @default(cuid())
  personaId      String?
  persona        Persona?      @relation(fields: [personaId], references: [id], onDelete: SetNull)
  /// null pour « Tester ».
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  /// Copie de `Conversation.source` (statistiques par source après suppression de la conversation).
  source         String?
  /// REPLY | FOLLOW_UP | SUMMARY | TEST.
  purpose        String
  model          String
  inputTokens    Int           @default(0)
  outputTokens   Int           @default(0)
  costEur        Decimal       @db.Decimal(10, 4)
  ok             Boolean
  /// Code d'erreur (auth, balance, rate_limit, server, invalid_output…).
  error          String?
  attempt        Int           @default(1)
  /// En-tête CF-RAY.
  requestId      String?
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@index([personaId, createdAt])
  @@index([conversationId])
}

// --- Phase 18 : assistant sur un VRAI compte Telegram (second transport) ----------------------------------------

/// Compte Telegram REEL (pas un bot) portant une persona de l'assistant : il n'affiche pas le badge « bot »,
/// il peut ecrire le premier, et il lit les messages par une connexion longue (MTProto).
/// Message prive envoye depuis un compte Telegram REEL (userbot). Mis en file par l'acceptation d'une demande,
/// relu par apps/userbot : un redemarrage ne perd rien.
model AccountDm {
  id             String              @id @default(cuid())
  accountId      String
  account        TelegramUserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelId      String?
  channel        Channel?            @relation(fields: [channelId], references: [id], onDelete: SetNull)
  membershipId   String?
  telegramUserId BigInt
  text           String
  dueAt          DateTime
  status         AccountDmStatus     @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, dueAt])
  @@index([accountId, createdAt])
}

enum AccountDmStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model TelegramUserAccount {
  id                 String      @id @default(cuid())
  /// Nom interne (« Lea »).
  label              String
  /// Numero au format international (+33612345678).
  phone              String      @unique
  /// Session GramJS (StringSession) chiffree AES-256-GCM.
  sessionEncrypted   String
  /// PENDING_CODE | PENDING_PASSWORD | ACTIVE | ERROR | DISCONNECTED
  status             String      @default("PENDING_CODE")
  /// Code envoye par Telegram, garde entre l'envoi et la saisie.
  phoneCodeHash      String?
  /// Persona portee par ce compte.
  personaId          String?
  persona            Persona?    @relation(fields: [personaId], references: [id], onDelete: SetNull)
  /// Identite Telegram, une fois connecte.
  telegramUserId     BigInt?
  telegramUsername   String?
  /// Proxy SOCKS5 facultatif (hote:port).
  proxyUrl           String?
  accountDms         AccountDm[]
  welcomeDmChannels  Channel[]   @relation("WelcomeDmAccount")
  /// Plafonds anti-bannissement.
  dailyCap           Int         @default(60)
  newConversationCap Int         @default(20)
  /// Paliers de montee en charge (jours depuis la connexion).
  warmupDay          Int         @default(0)
  isActive           Boolean     @default(false)
  lastActiveAt       DateTime?
  lastError          String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  /// Bot fantome qui porte les conversations de ce compte. L'API bot n'est pas utilisee :
  /// la reception et l'envoi passent par la session MTProto tenue par apps/userbot.
  botId String? @unique
  bot   Bot?    @relation(fields: [botId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([isActive])
}

// ============================================================
// Phase 19 : agents IA (Grand Chef, Chefs d'équipe, agents) — docs/AGENTS-ARCHITECTURE.md
// ============================================================

/// Réglages d'une équipe d'agents (`teamKey` : dating, casino, sports, algo). Simulation active par défaut : tant
/// qu'elle l'est, toute publication part sur le canal Test.
model AgentTeamConfig {
  id                  String   @id @default(cuid())
  teamKey             String   @unique
  enabled             Boolean  @default(true)
  simulation          Boolean  @default(true)
  paused              Boolean  @default(false)
  /// Motif de la dernière mise en pause (« 3 missions échouées de suite », « pause demandée par Telegram »…).
  pausedReason        String?
  /// 0 = je valide tout, 1 = je valide les nouveautés, 2 = autonomie totale.
  autonomyLevel       Int      @default(0)
  /// Plafonds mensuels en centimes par poste (JSON `{ llm, video, image, odds, screenshot }`).
  monthlyBudgetCents  Json     @default("{}")
  styleGuidelines     String   @default("")
  /// Mots interdits (JSON string[]).
  forbiddenWords      Json     @default("[]")
  maxTextLength       Int      @default(900)
  /// Heures calmes (JSON `{ start: "HH:MM", end: "HH:MM" }[]`, Europe/Paris).
  quietHours          Json     @default("[]")
  settings            Json     @default("{}")
  /// Échecs consécutifs (mise en pause automatique à 3).
  consecutiveFailures Int      @default(0)
  updatedById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Plan d'un canal pour son équipe : quotas, fenêtre horaire (Europe/Paris), espacement, mélange.
model ChannelAgentPlan {
  id                String   @id @default(cuid())
  channelId         String   @unique
  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  teamKey           String
  enabled           Boolean  @default(false)
  postsPerDay       Int      @default(3)
  /// « HH:MM » Europe/Paris.
  windowStart       String   @default("09:00")
  windowEnd         String   @default("22:00")
  minSpacingMinutes Int      @default(90)
  /// Parts du mélange (JSON `{ video, photo, text }`).
  mix               Json     @default("{\"video\":0,\"photo\":0,\"text\":1}")
  personaId         String?
  /// Campagne dont le bouton Offre est ajouté aux posts.
  campaignId        String?
  themes            Json     @default("[]")
  /// Phase 21 : fenêtres suggérées par l'équipe Algorithme (JSON `{ day, start, end, score }[]`, heure de Paris) et
  /// consignes « ce qui marche ici » lues par la Rédaction.
  suggestedWindows  Json     @default("[]")
  styleNotes        String?  @db.Text
  /// Phase 27 : profil de style (canal d'inspiration) lu par la Rédaction pour ce canal.
  styleProfileId    String?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([teamKey, enabled])
}

enum AgentMissionKind {
  POST
  BET
  REPORT
  ANALYSIS
}

enum AgentMissionStatus {
  PENDING
  RUNNING
  WAITING_VALIDATION
  WAITING_HUMAN
  DONE
  FAILED
  CANCELLED
  BLOCKED_BUDGET
}

enum AgentMissionCreator {
  GRAND_CHEF
  HUMAN
}

/// Une mission (une publication à produire), reprenable : `steps` garde l'état de chaque étape.
model AgentMission {
  id             String              @id @default(cuid())
  teamKey        String
  kind           AgentMissionKind    @default(POST)
  channelId      String?
  channel        Channel?            @relation(fields: [channelId], references: [id], onDelete: SetNull)
  status         AgentMissionStatus  @default(PENDING)
  currentStep    Int                 @default(0)
  /// JSON `{ agent, status, startedAt, endedAt, summary, costCents, error }[]`.
  steps          Json                @default("[]")
  /// JSON : texte, média, créneau, motifs…
  payload        Json                @default("{}")
  costCents      Int                 @default(0)
  /// Posé AVANT l'envoi : une mission ne publie jamais deux fois.
  postId         String?             @unique
  validationId   String?
  scheduledFor   DateTime?
  /// Jour du plan (AAAA-MM-JJ, Europe/Paris) pour lequel la mission a été créée.
  planDay        String?
  /// Mission de test (bouton « Créer une mission de test »).
  isTest         Boolean             @default(false)
  createdBy      AgentMissionCreator @default(GRAND_CHEF)
  createdById    String?
  /// Phase 33 : ordre de Kevin qui a fait créer la mission.
  orderId        String?
  order          TeamOrder?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  attempts       Int                 @default(0)
  lastError      String?
  lastActivityAt DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  runs        AgentRun[]
  validations AgentValidation[]
  posts       Post[]

  @@index([teamKey, status])
  @@index([channelId, scheduledFor])
  @@index([status, lastActivityAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([channelId, planDay])
  @@index([orderId])
}

/// Un passage d'un agent sur une mission.
model AgentRun {
  id            String       @id @default(cuid())
  missionId     String
  mission       AgentMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  agentKey      String
  stepIndex     Int          @default(0)
  /// RUNNING | OK | ERROR | SKIPPED
  status        String
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  durationMs    Int?
  costCents     Int          @default(0)
  inputSummary  String?
  outputSummary String?
  error         String?

  @@index([missionId, startedAt])
  @@index([agentKey, startedAt])
  @@index([startedAt])
}

enum AgentValidationStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
  EXPIRED
}

enum AgentDecisionVia {
  SITE
  TELEGRAM
}

/// Élément en attente d'une décision humaine (aperçu envoyé sur Telegram, file du site).
model AgentValidation {
  id                 String                @id @default(cuid())
  /// Numéro court (« ok 12 » sur Telegram).
  number             Int                   @unique @default(autoincrement())
  missionId          String
  mission            AgentMission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  teamKey            String
  previewText        String
  mediaAssetId       String?
  reason             String
  status             AgentValidationStatus @default(PENDING)
  decidedById        String?
  decidedVia         AgentDecisionVia?
  decidedAt          DateTime?
  rejectReason       String?
  telegramMessageId  Int?
  /// L'admin a appuyé sur « Corriger » : son prochain message texte remplace le texte.
  awaitingEditAt     DateTime?
  editedText         String?
  remindedAt         DateTime?
  /// Phase 26 : membre de l'équipe (identifiant Telegram) à qui la validation est adressée ; null = l'admin.
  assigneeTelegramId BigInt?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([teamKey, status])
}

/// Dépense d'une équipe chez un fournisseur, par mois (plafonds).
enum BotRole {
  CHANNEL
  ADMIN
}

/// Phase 26 : un tour du dialogue avec le Boss (message de l'admin ou réponse du Boss). Un secret y devient « [secret] ».
model BossTurn {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  /// ADMIN | BOSS
  role              String
  text              String
  /// Clé de l'action du catalogue choisie (ou « question », « pas_prevu », « preciser », commande exacte…).
  actionKey         String?
  /// done | confirm | refused | error | unmet | clarify | answered
  status            String?
  /// text | voice | button
  source            String?
  telegramMessageId Int?
  costCents         Int      @default(0)
  /// Phase 26 : conversation (privée ou groupe de l'équipe) et auteur du message (null pour un tour de Kevin).
  chatId            BigInt?
  fromTelegramId    BigInt?

  @@index([createdAt])
  @@index([chatId, createdAt])
  @@index([fromTelegramId, createdAt])
}

enum TeamMemberRole {
  ADMIN
  MANAGER
  MEMBER
}

/// Phase 26 : personne de l'équipe présentée à Kevin (le Boss) par l'admin ou un manager.
model TeamMember {
  id                     String         @id @default(cuid())
  telegramUserId         BigInt         @unique
  username               String?
  firstName              String
  role                   TeamMemberRole @default(MEMBER)
  /// Une ligne : « vidéos casino et posts roulette ».
  roleLabel              String?
  /// `{ teams: ("dating"|"casino"|"sports"|"algo"|"ads")[], kinds: ("media"|"secret"|"choice"|"validation")[] }`
  responsibilities       Json           @default("{}")
  available              Boolean        @default(true)
  awayUntil              DateTime?
  /// Notes datées `[{ at, text, by }]` (ce qu'elle a dit d'elle-même ou ce que l'admin a dit d'elle).
  notes                  Json           @default("[]")
  /// A fait /start en privé avec Kevin (peut recevoir un message privé, y envoyer un secret).
  startedPrivateAt       DateTime?
  introducedByTelegramId BigInt?
  removedAt              DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

/// Phase 26 : besoin de l'admin que le Boss ne sait pas encore couvrir (carnet de la phase suivante).
model BossUnmet {
  id                  String   @id @default(cuid())
  /// Texte normalisé (minuscules, sans accents ni ponctuation) : un même besoin compte une fois.
  key                 String   @unique
  text                String
  count               Int      @default(1)
  firstAt             DateTime @default(now())
  lastAt              DateTime @default(now())
  /// Phase 33 : capacité qui manque (« programmer des shorts »), équipe concernée, dernier ordre lié.
  suggestedCapability String?
  teamKey             String?
  lastOrderId         String?
}

enum TeamOrderKind {
  PROGRAM
  ONE_SHOT
  ADJUST
  ASK
  WHAT_IF
}

enum TeamOrderStatus {
  DRAFT
  WAITING_CONFIRM
  RUNNING
  DONE
  CANCELLED
  BLOCKED
  FAILED
}

/// Phase 33 : ordre donné par l'admin à une équipe, par Kevin (interprété, planifié, récapitulé, exécuté par le Grand
/// Chef et le Chef de l'équipe, suivi et rapporté).
model TeamOrder {
  id             String                @id @default(cuid())
  /// Numéro court (« ordre n°12 »).
  number         Int                   @unique @default(autoincrement())
  requestText    String
  /// Plan validé par le code : `{ teamKey, asIfTeamKey?, scope, kind, period, perDay?, theme?, categoryId?, format?, mode, steps[], resolved }`.
  interpretation Json                  @default("{}")
  recap          String                @default("")
  kind           TeamOrderKind
  teamKey        String
  status         TeamOrderStatus       @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  /// `{ missionsPlanned, missionsDone, missionsFailed, lastReportAt, lastReportDay, perDay: [{ day, done, failed, postIds[] }] }`
  progress       Json                  @default("{}")
  /// `[{ part, reason, alternatives[] }]`
  impossible     Json?
  createdById    String?
  /// Conversation Telegram d'origine (rapports au même endroit).
  chatId         String?
  pendingId      String?
  /// Texte normalisé de la demande (plan réutilisé 24 h).
  planCacheKey   String?
  costCents      Int                   @default(0)
  missions       AgentMission[]
  overrides      ChannelPlanOverride[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, teamKey])
  @@index([planCacheKey, createdAt])
}

/// Phase 33 : dérogation datée au plan d'un canal, posée par un ordre, lue par le Grand Chef avant `ChannelAgentPlan` ;
/// s'éteint seule après `toDay` (le plan de base ne bouge jamais).
model ChannelPlanOverride {
  id            String    @id @default(cuid())
  channelId     String
  orderId       String
  order         TeamOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Équipe qui travaille le canal pendant la période (peut différer du plan : « faire comme si »).
  teamKey       String
  /// AAAA-MM-JJ Europe/Paris, bornes comprises.
  fromDay       String
  toDay         String
  postsPerDay   Int?
  picksPerDay   Int?
  betCategoryId String?
  themes        Json?
  mix           Json?
  format        String?
  windowStart   String?
  windowEnd     String?
  personaId     String?
  isTest        Boolean   @default(false)
  /// Fermée avant terme (ordre arrêté).
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([channelId, fromDay, toDay])
  @@index([orderId])
}

model AgentUsage {
  id         String   @id @default(cuid())
  teamKey    String
  /// llm | video | image | odds | screenshot
  provider   String
  /// AAAA-MM (Europe/Paris)
  month      String
  cents      Int      @default(0)
  calls      Int      @default(0)
  /// Alertes déjà envoyées ce mois (80, 100).
  alerted80  Boolean  @default(false)
  alerted100 Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([teamKey, provider, month])
}

enum HumanRequestKind {
  SECRET
  TEXT
  CHOICE
  MEDIA
  CONFIRM
}

enum HumanRequestStatus {
  QUEUED
  PENDING
  ANSWERED
  SKIPPED
  EXPIRED
}

/// Demande faite au client par le bot du dialogue admin (une seule question à la fois : QUEUED attend son tour).
model HumanRequest {
  id                 String             @id @default(cuid())
  teamKey            String?
  kind               HumanRequestKind
  /// Ce qui est demandé (`providers.fal.apiKey`, `agents.dailyReport`…).
  key                String
  question           String
  options            Json               @default("[]")
  expected           Json               @default("{}")
  status             HumanRequestStatus @default(QUEUED)
  /// Jamais un secret (pour une clé : « …ab12 »).
  answerSummary      String?
  askedAt            DateTime?
  telegramMessageId  Int?
  remindedAt         DateTime?
  answeredAt         DateTime?
  missionId          String?
  onAnswer           Json               @default("{}")
  /// Phase 26 : membre de l'équipe à qui la question est adressée (null = l'admin) et conversation où elle a été
  /// posée (null = conversation privée avec l'admin ; sinon le groupe de l'équipe). Le message posé reste
  /// `telegramMessageId`.
  assigneeTelegramId BigInt?
  chatId             BigInt?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([key, status])
}

enum MediaAssetKind {
  SOURCE
  GENERATED
  PHOTO
  REFERENCE
  /// Capture d'écran d'un site de bookmaker (phase 23).
  SCREENSHOT
  /// Vidéo longue envoyée par le client pour le montage (phase 28).
  LONG_VIDEO
  /// Short produit par l'équipe Montage (phase 28).
  SHORT
}

enum MediaAssetOrigin {
  HUMAN
  AI
  /// Capture du site d'un bookmaker (phase 23) : ni fournie par le client, ni générée.
  HUMAN_SITE
  /// Image de repli fabriquée par nous à partir d'un gabarit (capture impossible, phase 23).
  TEMPLATE
}

/// Utilisation d'un média de la médiathèque sur un canal (jamais deux fois en 30 jours sur le même canal).
model MediaUsage {
  id        String     @id @default(cuid())
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  postId    String?
  missionId String?
  usedAt    DateTime   @default(now())

  @@index([channelId, usedAt])
  @@index([assetId, usedAt])
}

// ============================================================
// Phase 21 : équipe Algorithme (ce qui marche, tests A/B, réglages)
// ============================================================

/// Fiche de résultats d'un post envoyé : chiffres et caractéristiques (recalculée chaque nuit).
model PostInsight {
  id             String   @id @default(cuid())
  postId         String   @unique
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  channelId      String
  vertical       String?
  sentAt         DateTime
  /// Vues interpolées depuis `PostViewSample` (null sans relevé).
  views1h        Int?
  views2h        Int?
  views24h       Int?
  viewsFinal     Int      @default(0)
  forwards       Int      @default(0)
  reactions      Int      @default(0)
  clicks         Int      @default(0)
  offerClicks    Int      @default(0)
  registrations  Int      @default(0)
  ftds           Int      @default(0)
  deposits       Int      @default(0)
  /// VIDEO | PHOTO | ALBUM | TEXT
  format         String
  theme          String?
  categoryId     String?
  personaId      String?
  textLength     Int      @default(0)
  emojiCount     Int      @default(0)
  hasButtons     Boolean  @default(false)
  /// Heure (0-23) et jour (1 = lundi … 7 = dimanche), Europe/Paris.
  hourParis      Int
  weekdayParis   Int
  abGroupId      String?
  abVariant      String?
  agentMissionId String?
  model          String?
  experimentId   String?
  /// Phase 23 : résultat du pari publié par ce post (WON | LOST | VOID), null si ce n'est pas un pari.
  betResult      String?
  computedAt     DateTime @default(now())

  @@index([channelId, sentAt])
  @@index([vertical, sentAt])
  @@index([format])
  @@index([sentAt])
}

enum ExperimentKind {
  STYLE_LEGENDE
  HORAIRE
  MELANGE
  REGLAGE_PERSONA
}

enum ExperimentStatus {
  PROPOSED
  RUNNING
  CLOSED
  CANCELLED
}

/// Test A/B monté par l'agent Expérimentation (un seul actif par canal et par type).
model Experiment {
  id               String           @id @default(cuid())
  teamKey          String
  channelId        String?
  personaId        String?
  kind             ExperimentKind
  hypothesis       String
  /// JSON `{ A: {...}, B: {...} }` (libellé et réglage de chaque variante).
  variants         Json
  /// offer_ctr | views24h | reply_rate | registrations
  metric           String
  minSamples       Int              @default(20)
  status           ExperimentStatus @default(PROPOSED)
  startedAt        DateTime?
  endsAt           DateTime?
  closedAt         DateTime?
  /// JSON : effectifs, taux, p-value.
  result           Json?
  /// A | B | NONE
  winner           String?
  recommendationId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, channelId])
  @@index([teamKey, status])
}

enum RecommendationStatus {
  PROPOSED
  APPLIED
  UNDONE
  REJECTED
  /// Phase 24 (Agent Ads) : le client dit avoir fait l'action lui-même chez Meta / TikTok (jamais appliquée par le code).
  DONE
}

enum RecommendationAppliedBy {
  GRAND_CHEF
  HUMAN
}

/// Réglage proposé par l'équipe Algorithme ; « avant » garde de quoi annuler en un clic.
model Recommendation {
  id                 String                   @id @default(cuid())
  teamKey            String
  /// CHANNEL_PLAN | TEAM_CONFIG | PERSONA
  target             String
  targetId           String
  field              String
  before             Json?
  after              Json
  evidence           Json                     @default("{}")
  expectedGain       String?
  /// SMALL (horaires, mélange) | BIG (persona, quota) : décide de l'application seule au niveau 1.
  size               String                   @default("SMALL")
  status             RecommendationStatus     @default(PROPOSED)
  appliedAt          DateTime?
  appliedBy          RecommendationAppliedBy?
  appliedById        String?
  undoneAt           DateTime?
  undoneById         String?
  rejectedAt         DateTime?
  /// Phase 24 : action conseillée par l'Agent Ads (STOP | SCALE | TEST | WATCH), commentaire du client, fait le.
  action             String?
  comment            String?
  doneAt             DateTime?
  doneById           String?
  weekStart          String?
  /// Phase 27 : origine de la proposition (`algo` par défaut, `inspiration` = canal de référence).
  source             String                   @default("algo")
  referenceChannelId String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([status, teamKey])
  @@index([target, targetId])
  @@index([source, referenceChannelId])
}

enum ReferenceVia {
  WEB
  ACCOUNT
  FORWARDED
}

enum ReferenceStatus {
  READING
  READY
  UNAVAILABLE
}

/// Phase 27 : canal de référence (« canal d'inspiration ») lu par Kevin. Jamais rejoint de force ; aucun membre lu.
model ReferenceChannel {
  id                String          @id @default(cuid())
  /// Nom public (sans @), si connu.
  username          String?
  /// Identifiant Telegram du canal (voie compte réel ou posts transférés), si connu.
  telegramChatId    BigInt?
  title             String?
  via               ReferenceVia
  /// dating | casino | sports
  universe          String
  /// Canaux du client (`Channel.id`) qui s'en inspirent (même univers obligatoire).
  targetChannelIds  Json            @default("[]")
  status            ReferenceStatus @default(READING)
  unavailableReason String?
  /// Compte réel (phase 18) qui lit le canal, voie ACCOUNT.
  accountId         String?
  addedByTelegramId BigInt?
  postCount         Int             @default(0)
  lastReadAt        DateTime?
  nextReadAt        DateTime?
  removedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  posts             ReferencePost[]
  styleProfiles     StyleProfile[]

  @@index([status])
  @@index([username])
  @@index([telegramChatId])
}

/// Phase 27 : caractéristiques d'un post du canal de référence. Le texte brut est effacé après 30 jours ; aucun média
/// n'est téléchargé.
model ReferencePost {
  id                 String           @id @default(cuid())
  referenceChannelId String
  referenceChannel   ReferenceChannel @relation(fields: [referenceChannelId], references: [id], onDelete: Cascade)
  /// Numéro du message dans le canal de référence.
  externalId         Int
  postedAt           DateTime
  via                ReferenceVia
  /// Texte brut (30 jours au plus, voir `textPurgedAt`).
  text               String?          @db.Text
  textPurgedAt       DateTime?
  /// Empreinte du texte (contrôle « jamais de copie » après la purge).
  textHash           String?
  /// Empreintes des suites de 8 mots (JSON `string[]`, hachées) : contrôle de copie sans garder le texte.
  shingles           Json             @default("[]")
  length             Int              @default(0)
  lines              Int              @default(0)
  emojiCount         Int              @default(0)
  /// text | photo | video | poll | document | other
  mediaKind          String           @default("text")
  views              Int?
  hasLink            Boolean          @default(false)
  hasButton          Boolean          @default(false)
  hasPrice           Boolean          @default(false)
  hasOdds            Boolean          @default(false)
  hasVipCall         Boolean          @default(false)
  keywords           Json             @default("[]")
  /// Autres mesures (hashtags, mentions, questions, majuscules, série pari → résultat…).
  features           Json             @default("{}")
  createdAt          DateTime         @default(now())

  @@unique([referenceChannelId, externalId])
  @@index([referenceChannelId, postedAt])
  @@index([textPurgedAt, createdAt])
}

/// Phase 27 : profil de style tiré d'un canal de référence (règles, description, exemples écrits à neuf), versionné.
model StyleProfile {
  id                 String           @id @default(cuid())
  referenceChannelId String
  referenceChannel   ReferenceChannel @relation(fields: [referenceChannelId], references: [id], onDelete: Cascade)
  version            Int              @default(1)
  universe           String
  /// Chiffres du code (rythme, forme, fond, résultats) au moment du profil.
  stats              Json             @default("{}")
  /// Règles de style (5 à 10), description (ton, structure, accroches, offre), exemples écrits à neuf.
  rules              Json             @default("[]")
  description        String?          @db.Text
  examples           Json             @default("[]")
  /// Règles du client que le style de référence violerait (signalées, jamais reproduites).
  flagged            Json             @default("[]")
  costCents          Int              @default(0)
  createdAt          DateTime         @default(now())

  @@unique([referenceChannelId, version])
}

/// Rapport « Ce qui marche » (par équipe et par semaine).
model InsightReport {
  id        String    @id @default(cuid())
  teamKey   String
  /// AAAA-MM-JJ (lundi, Europe/Paris)
  weekStart String
  content   String    @db.Text
  stats     Json      @default("{}")
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([teamKey, weekStart])
}

// ============================================================
// Phase 23 : équipe Paris sportifs (cotes, sélection, captures, résultats)
// ============================================================

/// Catégorie de paris (« tirs cadrés », « corners »…) : marchés chez le fournisseur de cotes, critères, destination.
model BetCategory {
  id                      String    @id @default(cuid())
  key                     String    @unique
  name                    String
  sport                   String    @default("SOCCER")
  /// Identifiants de marchés chez le fournisseur (`oddID` SportsGameOdds, avec PLAYER_ID / statEntityID génériques).
  marketTypes             Json      @default("[]")
  /// Ligues (`leagueID` du fournisseur).
  leagues                 Json      @default("[]")
  /// Bookmakers cibles (clés : `sportaza`, `5gringos`…).
  bookmakers              Json      @default("[]")
  minOdds                 Float     @default(1.5)
  maxOdds                 Float     @default(3.5)
  picksPerDay             Int       @default(2)
  /// Canaux de destination (JSON string[] d'identifiants `Channel`).
  channelIds              Json      @default("[]")
  campaignId              String?
  minMinutesBeforeKickoff Int       @default(30)
  /// Écart de cote toléré entre la sélection et l'envoi (5 % par défaut).
  maxOddsDriftPct         Float     @default(5)
  active                  Boolean   @default(false)
  /// Phase 33 : catégorie créée pour un ordre de Kevin (inactive après `expiresAt`, jamais supprimée).
  createdByOrderId        String?
  expiresAt               DateTime?
  sortOrder               Int       @default(0)
  updatedById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  picks BettingPick[]
}

enum BettingPickStatus {
  PROPOSED
  PUBLISHED
  SKIPPED
  WON
  LOST
  VOID
}

/// Pari retenu par l'équipe Paris sportifs : match, marché, cotes, raisonnement chiffré, capture, résultat.
model BettingPick {
  id                String            @id @default(cuid())
  missionId         String?
  categoryId        String
  category          BetCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Identifiant du match chez le fournisseur de cotes.
  eventId           String
  homeTeam          String
  awayTeam          String
  league            String
  kickoffAt         DateTime
  /// `oddID` du fournisseur et libellés lisibles.
  marketId          String
  marketLabel       String
  selectionLabel    String
  line              Float?
  bookmaker         String
  /// Cotes décimales.
  odds              Float
  consensusOdds     Float?
  interestScore     Float?
  oddsAtSend        Float?
  /// Raisonnement chiffré (JSON : écart de valeur, moyennes, probabilité de consensus…).
  reasoning         Json              @default("{}")
  screenshotAssetId String?
  postId            String?
  status            BettingPickStatus @default(PROPOSED)
  skipReason        String?
  /// Phase 35 : bookmaker du client lu directement (clé `BookmakerSite`), identifiant du match sur ce site, les deux
  /// lectures (`BookmakerOdds.id`) qui ont validé la cote, niveau de lecture retenu (api | dom | image).
  siteKey           String?
  siteEventId       String?
  oddsReadIds       Json?
  oddsLevel         String?
  /// Statistiques du match après coup (score, tirs cadrés, corners…).
  result            Json?
  settledAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, kickoffAt])
  @@index([categoryId, createdAt])
  @@index([eventId, marketId])
}

/// Phase 35 : bookmaker du client lu directement par le système (Celsius, Sportaza, Bet Portal…). Lecture seule, jamais
/// de mise ; identifiants communs chiffrés (`Setting agents.secret.providers.bookmakers.default.credentials`).
model BookmakerSite {
  /// « celsius », « sportaza », « betportal »
  key          String            @id
  label        String
  /// Adresse de la section paris sportifs.
  baseUrl      String?
  sportsPath   String?
  /// Moteur de paris détecté (iframes, scripts) : betby, altenar, digitain, betconstruct, kambi, sportradar, softswiss,
  /// inconnu.
  providerHint String?
  /// auto | server | mac (auto : serveur si joignable, sinon Mac).
  readTarget   String            @default("auto")
  isActive     Boolean           @default(true)
  /// NEW, LEARNING, READY, DEGRADED, BLOCKED
  status       String            @default("NEW")
  statusReason String?
  lastReadAt   DateTime?
  lastOkAt     DateTime?
  recipes      BookmakerRecipe[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

/// Phase 35 : recette d'un site (comment lire ses matchs, marchés et cotes), apprise sur un enregistrement réel,
/// validée par le code, versionnée ; une seule active par site.
model BookmakerRecipe {
  id         String        @id @default(cuid())
  siteKey    String
  site       BookmakerSite @relation(fields: [siteKey], references: [key], onDelete: Cascade)
  version    Int
  /// api | dom
  level      String
  api        Json?
  dom        Json?
  mapping    Json          @default("{}")
  validation Json          @default("{}")
  isActive   Boolean       @default(false)
  /// learn | repair | manual | reuse
  createdBy  String
  createdAt  DateTime      @default(now())

  @@unique([siteKey, version])
  @@index([siteKey, isActive])
}

/// Phase 35 : travail de lecture d'un site, fait par le serveur ou par le Mac du client (runner).
model BookmakerReadJob {
  id         String    @id @default(cuid())
  siteKey    String
  /// learn | events | markets | verify | capture | test | visible
  kind       String
  /// server | mac
  target     String
  /// PENDING, CLAIMED, DONE, FAILED, NEEDS_HUMAN
  status     String    @default("PENDING")
  params     Json      @default("{}")
  /// Compteurs, erreurs classées, niveau utilisé, durée ; jamais de secret.
  result     Json?
  attempts   Int       @default(0)
  claimedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([siteKey, status, createdAt])
  @@index([target, status, createdAt])
}

/// Phase 35 : cache des matchs lus sur un site (20 minutes).
model BookmakerEvent {
  id           String   @id @default(cuid())
  siteKey      String
  siteEventId  String
  league       String
  leagueKey    String?
  homeTeam     String
  awayTeam     String
  startsAt     DateTime
  url          String?
  marketsCount Int?
  fetchedAt    DateTime
  /// Correspondance avec le match du fournisseur de cotes (résultats).
  oddsEventId  String?

  @@unique([siteKey, siteEventId])
  @@index([siteKey, startsAt])
}

/// Phase 35 : une lecture d'une cote par un chemin (api | dom | image) ; cache 3 minutes, double lecture avant publication.
model BookmakerOdds {
  id            String   @id @default(cuid())
  siteKey       String
  siteEventId   String
  marketSite    String
  marketKey     String?
  selectionSite String
  selectionKey  String?
  line          Float?
  odds          Float
  /// api | dom | image
  level         String
  readAt        DateTime
  jobId         String?

  @@index([siteKey, siteEventId, readAt])
}

/// Phase 28 — montage d'une vidéo longue en shorts (équipe Montage). Reprenable par `currentStep` ; aucun fichier
/// temporaire gardé ; la source reste dans Telegram (`MediaAsset.telegramRef`).
model MontageJob {
  id                String           @id @default(cuid())
  /// Équipe (« montage ») et univers des shorts (« casino » d'abord).
  teamKey           String           @default("montage")
  universe          String           @default("casino")
  sourceAssetId     String
  sourceAsset       MediaAsset       @relation("MontageSource", fields: [sourceAssetId], references: [id])
  /// { theme, format, durationTarget, pipPosition, subtitles, overlayText, count, speed, rawText }
  instructions      Json
  instructionsMsgId BigInt?
  /// Conversation Telegram d'origine (chaîne d'un BigInt) : plan, questions et aperçus y partent.
  chatId            String?
  status            MontageJobStatus @default(PENDING)
  currentStep       String?
  error             String?
  attempts          Int              @default(0)
  /// Métadonnées de la source (ffprobe) : durée ms, largeur, hauteur, codec, images/s, poids.
  sourceMeta        Json?
  /// Plan de coupe envoyé au client (message Telegram) et accord du client.
  planMsgId         BigInt?
  planApprovedAt    DateTime?
  shortCount        Int              @default(0)
  shorts            ShortClip[]
  createdById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  completedAt       DateTime?

  @@index([status, updatedAt])
}

enum MontageJobStatus {
  PENDING
  ANALYZING
  PLAN_SENT
  CUTTING
  DRESSING
  QC
  PREVIEW
  APPROVED
  DONE
  FAILED
  CANCELLED
}

/// Un short d'un montage. `assetId` posé quand le short final existe (MediaAsset SHORT gardé dans Telegram).
model ShortClip {
  id               String          @id @default(cuid())
  montageJobId     String
  montageJob       MontageJob      @relation(fields: [montageJobId], references: [id], onDelete: Cascade)
  assetId          String?
  asset            MediaAsset?     @relation(fields: [assetId], references: [id])
  index            Int
  startMs          Int
  endMs            Int
  durationMs       Int
  /// Pourquoi ce moment (plan de l'IA) et score d'intérêt (1 à 10).
  description      String?
  score            Int?
  format           ShortFormat     @default(VERTICAL_9_16)
  pipPosition      PipPosition     @default(NONE)
  speed            Float?
  subtitles        Boolean         @default(false)
  /// SRT vérifié (seul utilisé pour le burn-in) ; segments incertains en attente de la réponse du client.
  subtitlesSrt     String?
  subtitlesPending Json?
  overlayText      String?
  status           ShortClipStatus @default(PLANNED)
  /// Résultat du contrôle qualité (durée, résolution, noir, son, poids, lisibilité).
  qc               Json?
  /// Short compressé pour passer sous 50 Mo (Kevin le dit).
  compressed       Boolean         @default(false)
  previewMsgId     BigInt?
  clientFeedback   String?
  /// Nombre de refabrications (« le 5, raccourcis de 2 secondes »).
  redoCount        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([montageJobId, index])
}

enum ShortFormat {
  VERTICAL_9_16
  HORIZONTAL_16_9
  SQUARE_1_1
}

enum PipPosition {
  TOP_RIGHT
  TOP_LEFT
  BOTTOM_RIGHT
  BOTTOM_LEFT
  NONE
}

enum ShortClipStatus {
  PLANNED
  CUTTING
  DRESSING
  QC
  QC_FAILED
  PREVIEW_SENT
  APPROVED
  REJECTED
  REDO
  CANCELLED
}

/// Phase 29 — équipe Analystes : source surveillée (forum, Reddit, Telegram public, X, actualités). Débit et réglages de
/// lecture dans `scrapeConfig` ; désactivée après 5 échecs de suite ; une source découverte par l'IA naît inactive.
model TrendSource {
  id            String          @id @default(cuid())
  name          String
  url           String          @unique
  sourceType    TrendSourceType
  market        Vertical
  /// Codes pays ISO 3166-1 alpha-2 ; langues ISO 639-1.
  countries     Json            @default("[]")
  languages     Json            @default("[]")
  /// { rateLimitMs, maxPages, selectors?, pagination?, query?, robots? } (aucun identifiant).
  scrapeConfig  Json            @default("{}")
  isActive      Boolean         @default(true)
  /// « seed » (liste de départ), « discovered » (trouvée par l'IA), « client » (ajoutée par l'admin).
  origin        String          @default("seed")
  lastScrapedAt DateTime?
  nextScrapeAt  DateTime?
  errorCount    Int             @default(0)
  lastError     String?
  entries       TrendEntry[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([isActive, nextScrapeAt])
}

enum TrendSourceType {
  FORUM
  REDDIT
  TELEGRAM
  TWITTER
  NEWS
  OTHER
}

/// Une entrée de veille : résumé en français (500 caractères), lien, date, classement. Le texte brut est effacé à 7 jours ;
/// aucun profil d'utilisateur de forum n'est gardé (pseudonyme seulement, jamais de vrai nom).
model TrendEntry {
  id              String           @id @default(cuid())
  sourceId        String
  source          TrendSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  market          Vertical
  countries       Json             @default("[]")
  language        String
  title           String?
  summary         String
  summaryOriginal String?
  url             String
  /// Empreinte de l'adresse normalisée (une entrée par contenu).
  urlHash         String           @unique
  author          String?
  publishedAt     DateTime?
  category        TrendCategory
  tags            Json             @default("[]")
  sentiment       TrendSentiment
  relevanceScore  Int
  /// Vérifiée par une deuxième lecture ; sinon présentée comme « non vérifiée ».
  verified        Boolean          @default(false)
  rawText         String?
  rawTextPurgeAt  DateTime?
  complianceRules ComplianceRule[]
  createdAt       DateTime         @default(now())

  @@index([market, createdAt])
  @@index([category, createdAt])
  @@index([rawTextPurgeAt])
}

enum TrendCategory {
  AD_STRATEGY
  AD_BAN
  AD_CREATIVE
  PLATFORM_CHANGE
  MARKET_TREND
  REGULATION
  OFFER
  TOOL
  DISCUSSION
  OTHER
}

enum TrendSentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

/// Règle de publicité observée sur une plateforme (pas un avis juridique) ; preuves sourcées ; une seule source =
/// non vérifiée ; revérifiée tous les 30 jours.
model ComplianceRule {
  id             String             @id @default(cuid())
  platform       CompliancePlatform
  market         Vertical
  /// ISO 3166-1 alpha-2, ou « ALL ».
  country        String
  rule           String
  riskLevel      RiskLevel
  /// [{ url, date, description }]
  evidence       Json               @default("[]")
  verified       Boolean            @default(false)
  workaround     String?
  isActive       Boolean            @default(true)
  lastVerifiedAt DateTime
  sourceEntryId  String?
  sourceEntry    TrendEntry?        @relation(fields: [sourceEntryId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([platform, market, country])
  @@index([riskLevel, isActive])
}

/// Plateformes des règles publicitaires (distinct de `AdPlatform` des connecteurs Meta / TikTok).
enum CompliancePlatform {
  META
  TIKTOK
  GOOGLE
  SNAP
  X
  TELEGRAM
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  BAN
}

/// Rapport de l'équipe Analystes (hebdomadaire, mensuel, ou briefing à la demande).
model StrategyReport {
  id              String             @id @default(cuid())
  /// Null = tous les marchés (rapport hebdomadaire).
  market          Vertical?
  countries       Json               @default("[]")
  period          String
  reportType      StrategyReportType
  title           String
  summary         String
  /// Sections structurées : tendances, règles, recommandations, sources.
  content         Json
  recommendations Json               @default("[]")
  requestedBy     String?
  requestText     String?
  /// Envoyé par Kevin (message Telegram).
  sentAt          DateTime?
  createdAt       DateTime           @default(now())

  @@index([reportType, createdAt])
}

enum StrategyReportType {
  WEEKLY
  MONTHLY
  ON_DEMAND
}

/// Phase 30 — vérification du QA Global (dernier verrou, Claude Fable 5.1). Une approbation vaut pour un contenu EXACT
/// (`contentHash`) ; le contenu gardé est masqué (aucun secret, aucune donnée personnelle).
model QaCheck {
  id          String        @id @default(cuid())
  contentType QaContentType
  contentId   String
  teamKey     String
  /// Empreinte SHA-256 du contenu vérifié (une modification annule l'approbation).
  contentHash String
  verdict     QaVerdict
  /// [{ code, message, severity }] ; vide si APPROVED sans remarque.
  reasons     Json          @default("[]")
  /// [{ field, expected, got, suggestion }] si REJECTED.
  corrections Json?
  /// Contenu vérifié, masqué et tronqué.
  content     Json?
  modelUsed   String
  durationMs  Int
  attempt     Int           @default(1)
  checkedBy   String        @default("qa-global")
  costCents   Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([contentType, contentId, createdAt])
  @@index([contentHash])
  @@index([verdict, createdAt])
  @@index([teamKey, createdAt])
}

enum QaContentType {
  POST
  SHORT
  REPORT
  KEVIN_RESPONSE
  RECOMMENDATION
  ALERT
  COMPLIANCE_RULE
}

enum QaVerdict {
  APPROVED
  REJECTED
  TIMEOUT
  ERROR
}

/// Phase 31 — équipe Prospection : un canal ou groupe Telegram PUBLIC de casino / paris sportifs repéré comme futur
/// affilié. Données publiques et minimales seulement (aucun texte de post, aucun membre). L'équipe ne contacte personne.
/// Champs nullables prévus pour la phase 32 (`telegramId`, `linkAffiAffiliateId`, `networkId`).
model Prospect {
  id                  String                @id @default(cuid())
  /// Sans @, minuscules ; null si lien d'invitation privé.
  username            String?               @unique
  telegramId          String?               @unique
  /// https://t.me/<username> ou https://t.me/+<hash>.
  channelUrl          String                @unique
  kind                ProspectKind          @default(CHANNEL)
  title               String                @default("")
  /// Description publique du canal (texte public court, gardé pour relire les contacts).
  descriptionRaw      String?
  /// Résumé IA en français, 200 caractères.
  summaryFr           String?
  vertical            ProspectVertical      @default(OTHER)
  verticalDetails     Json?
  contentType         String?
  language            String?
  languageConfidence  Float?
  countries           Json?
  geoSignals          Json?
  geoConfidence       Float?
  region              ProspectRegion        @default(UNKNOWN)
  regulatoryFlag      String?
  subscribers         Int?
  postsPerDay         Float?
  medianViews         Int?
  avgViews            Int?
  viewRate            Float?
  viewVarianceCv      Float?
  forwardRatio        Float?
  reactionRate        Float?
  commentRate         Float?
  linkDensity         Float?
  postingHours        Json?
  firstSeenPostAt     DateTime?
  lastPostAt          DateTime?
  authenticity        ProspectAuthenticity?
  authenticityReason  String?
  fakeFlags           Json?
  riskFlags           Json?
  monetization        Json?
  brands              Json?
  hasCompetitor       Boolean               @default(false)
  /// FREE, ROTATING, EXCLUSIVE, OURS.
  competitiveState    String?
  contactConfidence   ContactConfidence     @default(NONE)
  bestContact         String?
  score               Int?
  scoreBreakdown      Json?
  tier                ProspectTier?
  tierReason          String?
  dossier             String?
  dossierAt           DateTime?
  matchedOfferId      String?
  matchedOffer        AffiliateOffer?       @relation(fields: [matchedOfferId], references: [id], onDelete: SetNull)
  status              ProspectStatus        @default(DISCOVERED)
  statusChangedAt     DateTime?
  presentedAt         DateTime?
  snoozedUntil        DateTime?
  contactedAt         DateTime?
  respondedAt         DateTime?
  signedAt            DateTime?
  /// CPA, REVSHARE, HYBRID.
  dealType            String?
  dealTerms           Json?
  linkAffiAffiliateId String?
  networkId           String?
  /// DIRECTORY, WEB_SEARCH, SOCIAL, GRAPH_FORWARD, GRAPH_MENTION, FOLDER, ANALYSTS, MANUAL, ACCOUNT_SEARCH (phase 32).
  sourceType          String
  sourceDetail        String?
  discoveredFromId    String?
  /// Profondeur dans le graphe depuis une source directe (0 = trouvé directement).
  graphDepth          Int                   @default(0)
  cocitationCount     Int                   @default(0)
  /// Priorité d'enrichissement (MANUAL : 10 ; graphe : cocitations).
  priority            Int                   @default(0)
  discoveredAt        DateTime              @default(now())
  enrichedAt          DateTime?
  lastEnrichedAt      DateTime?
  enrichError         String?
  enrichAttempts      Int                   @default(0)
  nextEnrichAt        DateTime?
  contacts            ProspectContact[]
  notes               ProspectNote[]
  events              ProspectEvent[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([status, tier, score])
  @@index([region, status])
  @@index([status, priority, discoveredAt])
  @@index([presentedAt])
}

enum ProspectKind {
  CHANNEL
  GROUP
}

enum ProspectVertical {
  SPORTS
  CASINO
  BOTH
  OTHER
}

enum ProspectRegion {
  EU
  NON_EU
  UNKNOWN
}

enum ProspectAuthenticity {
  REAL
  SUSPECT_GENERIC
  SUSPECT_BOT
  REPOST
}

enum ContactConfidence {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum ProspectTier {
  A
  B
  C
  D
}

enum ProspectStatus {
  DISCOVERED
  ENRICHING
  UNREADABLE
  ENRICH_FAILED
  QUALIFIED
  DISQUALIFIED
  CONTACTED
  RESPONDED
  NEGOTIATING
  SIGNED
  ACTIVE
  CHURNED
  SKIPPED
  BLACKLISTED
}

/// Phase 31 — contact PUBLIC de prospection (username ou courriel affichés pour être contactés), avec sa preuve.
model ProspectContact {
  id         String              @id @default(cuid())
  prospectId String
  prospect   Prospect            @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type       ProspectContactType
  value      String
  label      String?
  source     String
  confidence ContactConfidence
  /// Extrait de 15 mots au plus.
  evidence   String?
  createdAt  DateTime            @default(now())

  @@unique([prospectId, type, value])
}

enum ProspectContactType {
  TELEGRAM_USERNAME
  EMAIL
  WEBSITE
  BOT
  SOCIAL
  MARKETPLACE
  LINKED_GROUP
  OTHER
}

model ProspectNote {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  note       String
  authorType String   @default("client")
  createdAt  DateTime @default(now())

  @@index([prospectId, createdAt])
}

/// Phase 31 — chronologie d'un prospect (DISCOVERED, ENRICHED, SCORED, PRESENTED, STATUS_CHANGED, NOTE, REMINDER, ALERT).
model ProspectEvent {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type       String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([prospectId, createdAt])
  @@index([type, createdAt])
}

/// Phase 31 — offre du client aux affiliés (CPA et / ou revshare), sert à mesurer l'adéquation d'un canal.
model AffiliateOffer {
  id           String           @id @default(cuid())
  brand        String
  vertical     ProspectVertical
  /// Pays acceptés ["FR","BE"].
  countries    Json             @default("[]")
  /// { cpa?: 100, revshare?: 30, hybrid?: { cpa, revshare } } en EUR.
  dealTypes    Json             @default("{}")
  trackingHint String?
  notes        String?
  isActive     Boolean          @default(true)
  prospects    Prospect[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

/// Phase 31 — journal d'une session de découverte (une source × un lot de langues × une verticale).
model ProspectSourceRun {
  id           String    @id @default(cuid())
  sourceType   String
  sourceDetail String?
  languages    Json      @default("[]")
  vertical     String?
  started      DateTime  @default(now())
  finished     DateTime?
  found        Int       @default(0)
  newCount     Int       @default(0)
  duplicates   Int       @default(0)
  errors       Json?
  pausedUntil  DateTime?

  @@index([sourceType, started])
}
