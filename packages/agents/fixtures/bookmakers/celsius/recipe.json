{
  "level": "api",
  "api": {
    "tokenSource": "GET https://celsius.test/api/v2/auth/token → champ « token » (aussi rangé dans le stockage local « token »), envoyé en « Authorization: Bearer »",
    "endpoints": [
      {
        "purpose": "events",
        "method": "GET",
        "urlTemplate": "https://celsius.test/api/v2/events?sport={sport}&date={date}&page={page}",
        "params": {
          "sport": "football"
        },
        "headers": [
          "authorization",
          "accept"
        ],
        "auth": "bearer",
        "pagination": {
          "param": "page",
          "start": 1,
          "step": 1,
          "max": 20
        },
        "responseShape": {
          "id": "data.events[].id",
          "home": "data.events[].participants.home",
          "away": "data.events[].participants.away",
          "startsAt": "data.events[].kickoff",
          "league": "data.events[].league.name",
          "marketsCount": "data.events[].marketCount",
          "hasMore": "meta.hasMore"
        }
      },
      {
        "purpose": "markets",
        "method": "GET",
        "urlTemplate": "https://celsius.test/api/v2/event/{eventId}/markets",
        "headers": [
          "authorization",
          "accept"
        ],
        "auth": "bearer",
        "pagination": null,
        "responseShape": {
          "eventId": "event.id",
          "home": "event.home",
          "away": "event.away",
          "market": "markets[].name",
          "line": "markets[].line",
          "selection": "markets[].outcomes[].label",
          "odds": "markets[].outcomes[].price"
        }
      }
    ]
  },
  "dom": {
    "football": {
      "candidates": [
        {
          "text": "Football",
          "role": "link"
        },
        {
          "css": "a[href*='/sports/football']"
        }
      ]
    },
    "dayToday": {
      "candidates": [
        {
          "text": "Aujourd'hui"
        },
        {
          "css": "a.cs-day"
        }
      ]
    },
    "eventList": {
      "candidates": [
        {
          "css": "a.cs-event"
        },
        {
          "css": "section.cs-league a"
        }
      ]
    },
    "eventRow": {
      "home": {
        "candidates": [
          {
            "css": ".cs-home"
          }
        ]
      },
      "away": {
        "candidates": [
          {
            "css": ".cs-away"
          }
        ]
      },
      "startsAt": {
        "candidates": [
          {
            "css": "time"
          },
          {
            "css": ".cs-time"
          }
        ]
      }
    },
    "marketTab": {
      "candidates": [
        {
          "role": "tab"
        },
        {
          "css": ".cs-tabs button"
        }
      ]
    },
    "market": {
      "name": {
        "candidates": [
          {
            "css": ".cs-market-name"
          },
          {
            "css": "section h3"
          }
        ]
      },
      "selection": {
        "candidates": [
          {
            "css": ".cs-sel"
          }
        ]
      },
      "odds": {
        "candidates": [
          {
            "css": ".cs-price"
          },
          {
            "css": "button"
          }
        ]
      }
    }
  },
  "mapping": {
    "marketMap": {
      "Match Result": "resultat",
      "Total Goals": "buts",
      "Corners O/U": "corners",
      "Shots on Target": "tirs-cadres"
    },
    "oddsFormat": "decimal",
    "timezone": "Europe/Paris"
  }
}
