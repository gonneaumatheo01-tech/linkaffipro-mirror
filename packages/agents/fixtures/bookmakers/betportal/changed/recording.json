=\"feed-outcome\"><span class=\"feed-outcome__label\">'+esc(s.n)+'</span>'+(m.ln!=null?' <i class=\"feed-outcome__line\">'+m.ln.toFixed(1)+'</i>':'')+' <span class=\"feed-outcome__price\">'+esc(s.p)+'</span></div>';});h+='</div>';});\ndocument.getElementById('match').innerHTML=h;\ndocument.querySelectorAll('.feed-tab').forEach(function(b){b.addEventListener('click',function(){var k=b.getAttribute('data-k');document.querySelectorAll('div[data-k]').forEach(function(d){if(d.getAttribute('data-k')===k)d.removeAttribute('hidden');else d.setAttribute('hidden','');});});});\ndocument.querySelectorAll('.feed-outcome__price').forEach(function(b){b.addEventListener('click',function(){window.betClicked=true;});});});</script>\n<script>(function(){var b=document.getElementById('cookie-banner');if(!b)return;if(document.cookie.indexOf('consent=1')>=0){b.remove();return;}var o=document.getElementById('cookie-ok');if(o)o.addEventListener('click',function(){document.cookie='consent=1; path=/';b.remove();});})();</script>\n</body></html>\n",
