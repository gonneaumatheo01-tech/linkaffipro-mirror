{
  "name": "linkaffipro-platform",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:userbot": "pnpm --filter ./apps/userbot dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @linkaffipro/db db:generate",
    "db:migrate": "pnpm --filter @linkaffipro/db db:migrate",
    "db:migrate:dev": "pnpm --filter @linkaffipro/db db:migrate:dev",
    "db:studio": "pnpm --filter @linkaffipro/db db:studio",
    "db:seed": "pnpm --filter @linkaffipro/db db:seed",
    "db:phase8": "pnpm --filter @linkaffipro/db db:phase8",
    "db:phase10": "pnpm --filter @linkaffipro/db db:phase10",
    "db:phase10:gains": "pnpm --filter @linkaffipro/db db:phase10:gains",
    "db:phase11": "pnpm --filter @linkaffipro/db db:phase11",
    "db:phase14": "pnpm --filter @linkaffipro/db db:phase14",
    "seed:templates": "pnpm --filter @linkaffipro/db seed:templates",
    "db:demo": "pnpm --filter @linkaffipro/db db:demo",
    "bots:register": "node --env-file-if-exists=.env.local --import tsx packages/telegram/scripts/register-bots.ts",
    "telegram:webhooks": "node --env-file-if-exists=.env.local --import tsx packages/telegram/scripts/set-webhooks.ts",
    "linkaffi:check": "node --env-file-if-exists=.env.local --import tsx packages/linkaffi/scripts/check.ts",
    "linkaffi:inspect": "node --env-file-if-exists=.env.local --import tsx packages/linkaffi/scripts/inspect.ts",
    "tg:send": "node scripts/tg-remote.mjs send",
    "tg:inbox": "node scripts/tg-remote.mjs inbox",
    "tg:diag": "node scripts/tg-remote.mjs diag",
    "sequences:backfill": "node --env-file-if-exists=.env.local --import tsx packages/telegram/scripts/backfill-sequences.ts",
    "db:restore": "node scripts/db-restore.mjs",
    "db:backup:now": "railway ssh --service worker -- su-exec node node apps/worker/dist/backup-now.js",
    "db:dump": "node scripts/db-dump.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "captures": "node --env-file-if-exists=.env.local --import tsx apps/web/scripts/captures.ts",
    "a11y": "node --env-file-if-exists=.env.local --import tsx apps/web/scripts/a11y.ts",
    "landing:test-page": "pnpm --filter web landing:test-page",
    "landing:measure": "node --env-file-if-exists=.env.local --import tsx apps/web/scripts/landing-measure.ts",
    "landing:browser-check": "node --env-file-if-exists=.env.local --import tsx apps/web/scripts/landing-browser-check.ts",
    "agents:bench-video": "node --env-file-if-exists=.env.local --import tsx apps/worker/scripts/bench-video.ts",
    "agents:upload-lora": "node --env-file-if-exists=.env.local --import tsx apps/worker/scripts/upload-lora.ts",
    "agents:report-now": "node --env-file-if-exists=.env.local --import tsx apps/worker/scripts/report-now.ts",
    "boss:unmet": "node --env-file-if-exists=.env.local --import tsx apps/worker/scripts/boss-unmet.ts",
    "agents:status": "node --env-file-if-exists=.env.local --import tsx apps/worker/scripts/agents-status.ts",
    "kevin:parity": "node --env-file-if-exists=.env.local --import tsx packages/agents/scripts/kevin-parity.ts",
    "montage:diag": "node --env-file-if-exists=.env.local --import tsx packages/agents/scripts/montage-diag.ts",
    "qa:diag": "node --env-file-if-exists=.env.local --import tsx packages/agents/scripts/qa-diag.ts",
    "agents:migrate-bet-categories": "node --env-file-if-exists=.env.local --import tsx apps/worker/scripts/migrate-bet-categories.ts"
  },
  "devDependencies": {
    "@linkaffipro/config": "workspace:*",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3"
  }
}
