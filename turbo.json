{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL", "APP_ENCRYPTION_KEY", "AUTH_SECRET", "AUTH_URL", "NEXTAUTH_URL", "AUTH_TRUST_HOST", "APP_BASE_URL", "TRACKING_HOST", "TRACKING_BASE_URL", "TELEGRAM_WEBHOOK_SECRET", "IP_HASH_SALT", "LINKAFFI_API_URL", "LINKAFFI_API_KEY", "LINKAFFI_ANON_KEY", "TZ", "PORT"],
  "tasks": {
    "db:generate": { "cache": false },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "env": ["NEXT_SKIP_TYPECHECK"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": { "dependsOn": ["^db:generate"] },
    "lint": { "dependsOn": ["^db:generate"] },
    "test": { "dependsOn": ["^db:generate"] },
    "dev": { "cache": false, "persistent": true, "dependsOn": ["^db:generate"] }
  }
}
