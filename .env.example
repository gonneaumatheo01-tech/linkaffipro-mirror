# ============================================================
# LinkAffi Pro — variables d'environnement (exemple)
# Copiez ce fichier en .env.local (ignoré par git) et remplissez-le.
# En production, ces variables sont définies sur Railway (services web et worker).
# ============================================================

# --- Base de données et file d'attente ---
# PostgreSQL (Railway : référence ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:password@localhost:5432/linkaffipro
# Redis pour BullMQ (Railway : référence ${{Redis.REDIS_URL}})
REDIS_URL=redis://localhost:6379

# --- Sécurité ---
# Clé de chiffrement AES-256-GCM des jetons de bots : 32 octets aléatoires en base64
# (générer avec : openssl rand -base64 32)
APP_ENCRYPTION_KEY=
# Secret des sessions Auth.js (openssl rand -base64 32)
AUTH_SECRET=
# Sel du hachage des adresses IP (openssl rand -hex 16)
IP_HASH_SALT=
# Secret envoyé par Telegram dans l'en-tête de chaque webhook (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# --- Adresses ---
# Adresse publique du site (sans barre oblique finale)
APP_BASE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Domaine des liens traqués (redirections 302)
TRACKING_HOST=goolink.eu
TRACKING_BASE_URL=https://goolink.eu

# --- Premier administrateur (créé par le seed s'il n'existe pas) ---
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_INITIAL_PASSWORD=changez-moi

# --- Link Affi (API en lecture seule, worker uniquement) ---
LINKAFFI_API_URL=https://igqzbemzzxvuehwnyotn.supabase.co/functions/v1/stats-api
LINKAFFI_API_KEY=
LINKAFFI_ANON_KEY=

# --- Divers ---
TZ=Europe/Paris
# Port HTTP du worker (Railway le fournit)
PORT=8080

# --- Jetons de bots (uniquement pour `pnpm bots:register`, puis à retirer) ---
# TELEGRAM_BOT_TOKEN_CASINO=
# TELEGRAM_BOT_TOKEN_SPORTS=
# TELEGRAM_BOT_TOKEN_DATING=
