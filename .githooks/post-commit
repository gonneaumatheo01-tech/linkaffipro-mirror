#!/usr/bin/env bash
# Pousse automatiquement le miroir public (canal de lecture de l'agent) apres chaque commit.
# En arriere-plan : ne bloque jamais le terminal ni le commit.
repo="$(git rev-parse --show-toplevel)"
branch="$(git rev-parse --abbrev-ref HEAD)"
mkdir -p "$repo/agent/logs"
( git -C "$repo" push mirror "$branch" --force --quiet >"$repo/agent/logs/mirror.log" 2>&1 ) &
( git -C "$repo" push origin "$branch" --quiet >"$repo/agent/logs/origin.log" 2>&1 ) &
exit 0
