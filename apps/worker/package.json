{
  "name": "worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude \"tests/integration/**\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@linkaffipro/agents": "workspace:*",
    "@linkaffipro/chat": "workspace:*",
    "@linkaffipro/connectors": "workspace:*",
    "@linkaffipro/core": "workspace:*",
    "@linkaffipro/db": "workspace:*",
    "@linkaffipro/linkaffi": "workspace:*",
    "@linkaffipro/mtproto": "workspace:*",
    "@linkaffipro/queue": "workspace:*",
    "@linkaffipro/telegram": "workspace:*",
    "@linkaffipro/userbot": "workspace:*",
    "@prisma/client": "~6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.12",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@linkaffipro/config": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
