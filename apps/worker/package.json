    "bullmq": "^6.3.12",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@linkaffipro/config": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
